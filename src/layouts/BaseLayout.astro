---
import '../styles/global.css';

import leagueGothic from '../assets/fonts/league-gothic-var.woff2?url';
import manrope from '../assets/fonts/manrope-var.woff2?url';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import { site } from '../content/site';

interface Props {
  title: string;
  description?: string;
  /** Path for the canonical URL, e.g. "/" or "/privacy". */
  path: string;
  onHome?: boolean;
  noindex?: boolean;
  /** Responsive LCP image to preload (must match the rendered <picture>). */
  preloadImage?: { srcset: string; sizes: string; type: string };
  /** JSON-LD objects rendered as application/ld+json data blocks (not executed). */
  structuredData?: object[];
}

const {
  title,
  description = site.description,
  path,
  onHome = false,
  noindex = false,
  preloadImage,
  structuredData = [],
} = Astro.props;

const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/og.jpg', Astro.site).href;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="author" content={site.name} />

    <link rel="preload" href={leagueGothic} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={manrope} as="font" type="font/woff2" crossorigin />
    {preloadImage && (
      <link
        rel="preload"
        as="image"
        imagesrcset={preloadImage.srcset}
        imagesizes={preloadImage.sizes}
        type={preloadImage.type}
        fetchpriority="high"
      />
    )}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: From idea to impact`} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <noscript>
      <link rel="stylesheet" href="/noscript.css" />
    </noscript>

    {structuredData.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader onHome={onHome} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter onHome={onHome} />
    <script>
      import { markReadyWhenIdle } from '../scripts/ready';

      markReadyWhenIdle();
    </script>
  </body>
</html>
