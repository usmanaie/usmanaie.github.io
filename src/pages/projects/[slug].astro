---
import { Picture } from 'astro:assets';

import PageIntro from '../../components/layout/PageIntro.astro';
import Pill from '../../components/ui/Pill.astro';
import { type Project, projects } from '../../content/projects';
import { site } from '../../content/site';
import SubPageLayout from '../../layouts/SubPageLayout.astro';

/**
 * Case study page built only from content already in the design (summary + features),
 * so the "View case study" buttons never lead nowhere. Longer write-ups can be added to
 * content/projects.ts later without changing this template.
 */
export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<SubPageLayout
  title={`${project.title} · ${site.name}`}
  description={project.summary}
  path={`/projects/${project.slug}`}
>
  <article class="case" aria-labelledby="case-title">
    <div class="case__intro">
      <PageIntro
        id="case-title"
        title={project.title}
        eyebrow={project.eyebrow}
        intro={project.summary}
        back={{ href: '/projects', label: 'All projects' }}
      />
    </div>
    <figure class="case__media">
      <Picture
        src={project.image}
        alt={project.imageAlt}
        formats={['avif', 'webp']}
        widths={[480, 760, 1206]}
        quality={80}
        sizes="(width >= 64rem) 660px, calc(100vw - 32px)"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
    <section class="case__section case__section--features" aria-labelledby="case-features">
      <h2 id="case-features" class="case__heading">
        Features
      </h2>
      <ul role="list" class="case__features">
        {project.features.map((feature) => (
          <li class="case__feature">{feature}</li>
        ))}
      </ul>
    </section>
    <section class="case__section case__section--next" aria-labelledby="case-next">
      <h2 id="case-next" class="case__heading">
        Want the full story?
      </h2>
      <p class="case__text">
        Detailed write-ups are shared on request, so client specifics stay confidential. Get in touch to talk through
        the architecture, delivery and results.
      </p>
      <Pill href="/#contact" class="case__cta">
        GET IN TOUCH
      </Pill>
    </section>
  </article>
</SubPageLayout>

<style>
  .case {
    display: grid;
    gap: 48px;
    max-width: 760px;
  }

  /*
   * Desktop: two balanced columns, the story (intro, features, next step) on the left and the
   * project image on the right, centred against it. Phones keep the reading order: intro,
   * image, features, next step.
   */
  @media (width >= 64rem) {
    .case {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      grid-template-areas:
        'intro media'
        'features media'
        'next media';
      align-content: center;
      gap: 40px 72px;
      max-width: none;
      min-height: calc(100svh - var(--header-height) - 160px);
    }

    .case__intro {
      grid-area: intro;
    }

    .case__media {
      grid-area: media;
      align-self: center;
    }

    .case__section--features {
      grid-area: features;
    }

    .case__section--next {
      grid-area: next;
    }
  }

  .case__media {
    overflow: hidden;
  }

  .case__media :global(img) {
    width: 100%;
  }

  .case__heading {
    font-weight: 300;
    font-size: var(--fs-h3-card);
    line-height: 1.2;
    color: var(--color-heading);
  }

  /* Feature chips: the pills' signature border, quietened, with the bullets' red diamond. */
  .case__features {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 18px 0 0;
  }

  .case__feature {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 8px 15px 8px 13px;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    background:
      linear-gradient(var(--color-pill-fill-alt), var(--color-pill-fill-alt)) padding-box,
      linear-gradient(90deg, rgb(47 107 255 / 55%), rgb(106 91 216 / 55%), rgb(255 59 78 / 55%)) border-box;
    font-size: var(--fs-body-xs);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-heading);
  }

  .case__feature::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    background: var(--color-red-450);
    transform: rotate(45deg);
  }

  @media (forced-colors: active) {
    .case__feature {
      border-color: CanvasText;
    }
  }

  .case__text {
    max-width: 560px;
    margin-block: 14px 24px;
    color: var(--color-text-muted);
  }
</style>
