---
import { getImage } from 'astro:assets';

import About from '../components/sections/About.astro';
import Certifications from '../components/sections/Certifications.astro';
import Contact from '../components/sections/Contact.astro';
import Education from '../components/sections/Education.astro';
import Experience from '../components/sections/Experience.astro';
import Expertise from '../components/sections/Expertise.astro';
import Hero from '../components/sections/Hero.astro';
import Projects from '../components/sections/Projects.astro';
import Reviews from '../components/sections/Reviews.astro';
import { reviewsContent, reviewsEnabled } from '../content/reviews-source';
import { site } from '../content/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { robotImage } from '../lib/hero-image';
import { homeStructuredData } from '../lib/structured-data';

const lcp = await getImage({
  src: robotImage.src,
  widths: [...robotImage.widths],
  sizes: robotImage.sizes,
  quality: robotImage.quality,
  format: 'avif',
});
---

<BaseLayout
  title={`${site.name} · ${site.jobTitle}`}
  path="/"
  onHome
  noindex={import.meta.env['PUBLIC_REVIEWS_FIXTURE'] === 'true'}
  structuredData={homeStructuredData(Astro.site)}
  preloadImage={{ srcset: lcp.srcSet.attribute, sizes: robotImage.sizes, type: 'image/avif' }}
>
  <Hero />
  <About />
  <Education />
  <Expertise />
  <Projects />
  <Experience />
  <Certifications />
  {reviewsEnabled && <Reviews content={reviewsContent} />}
  <Contact />
</BaseLayout>
