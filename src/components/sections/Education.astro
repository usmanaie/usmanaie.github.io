---
import { education } from '../../content/education';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section id="education" class="education section-glow" aria-labelledby="education-title">
  <div class="education__inner container">
    <SectionHeading id="education-title" lead={education.heading.lead} accent={education.heading.accent} />
    <p class="section-intro education__intro">{education.intro}</p>
    <ul role="list" class="education__grid">
      {education.items.map((item) => (
        <li class:list={['edu-card', { 'edu-card--featured': item.featured }]}>
          <h3 class="edu-card__title">
            {item.title[0]}
            <br class="edu-card__break" />
            {item.title[0].endsWith('-') ? '' : ' '}
            {item.title[1]}
          </h3>
          <p class="edu-card__body">{item.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .education {
    padding-block: 40px 11px;
    background: var(--color-bg);
    text-align: center;
  }

  .education__intro {
    max-width: 680px;
    margin: 16px auto 0;
    line-height: var(--lh-body-loose);
  }

  .education__grid {
    display: grid;
    gap: 24px;
    max-width: 32rem;
    margin: 17px auto 0;
  }

  .edu-card {
    padding: 26px 30px 24px;
    border: 1px solid var(--color-card-border);
    background: var(--gradient-card);
    transition:
      transform var(--dur-card) ease,
      box-shadow var(--dur-card) ease;
  }

  .edu-card--featured {
    border-color: transparent;
    background:
      var(--gradient-card) padding-box,
      var(--gradient-card-feature-border) border-box;
  }

  .edu-card:hover {
    transform: var(--lift-card);
    box-shadow: var(--shadow-card-hover);
  }

  .edu-card__title {
    margin-block-end: 18px;
    font-weight: 300;
    font-size: var(--fs-h3-card);
    line-height: 1.1667;
    letter-spacing: -0.01em;
    color: var(--color-heading);
  }

  .edu-card__break {
    display: none;
  }

  .edu-card__body {
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  @media (width >= 56rem) {
    .education__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: none;
    }

    .edu-card {
      min-height: 188px;
      padding-block-end: 0;
    }

    .edu-card__break {
      display: inline;
    }
  }

  @media (forced-colors: active) {
    .edu-card--featured {
      border-color: Highlight;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .edu-card {
      transition: none;
    }

    .edu-card:hover {
      transform: none;
    }
  }
</style>
