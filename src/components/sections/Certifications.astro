---
import { Image } from 'astro:assets';

import { credentials, shownCompletionBadges, shownSkillBadges } from '../../content/credentials';
import Icon from '../ui/Icon.astro';
import Pill from '../ui/Pill.astro';
import SectionHeading from '../ui/SectionHeading.astro';

/**
 * Certifications (#certifications): the Google Cloud professional certification beside the
 * heading, then skill badges as a gallery and completion badges as a scrolling rail. Every badge
 * links to its public page on Google Skills, so visitors can verify it.
 */
const { certification: cert, profile } = credentials;

/** Line icons (24px grid, stroked like the rest of the UI) for the stats. */
const ICONS = {
  award: ['M12 15a6 6 0 1 0 0-12 6 6 0 0 0 0 12Z', 'm8.2 13.9-1.2 7.1 5-3 5 3-1.2-7.1'],
  shield: ['M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z', 'm9 12 2 2 4-4'],
  cap: ['M22 10 12 5 2 10l10 5 10-5Z', 'M6 12v5c3 3 9 3 12 0v-5'],
  trophy: ['M8 21h8', 'M12 17v4', 'M7 4h10v5a5 5 0 0 1-10 0V4Z', 'M17 5h3v2a3 3 0 0 1-3 3', 'M7 5H4v2a3 3 0 0 0 3 3'],
};

const stats = [
  { icon: ICONS.award, value: '1', label: 'Professional certification' },
  { icon: ICONS.shield, value: String(shownSkillBadges.length), label: 'Skill badges' },
  { icon: ICONS.cap, value: String(shownCompletionBadges.length), label: 'Completion badges' },
  { icon: ICONS.trophy, value: 'GOLD', label: `League on ${profile.platform}` },
];

const monthYear = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const totalBadges = credentials.skillBadges.length + credentials.completionBadges.length;
---

<section id="certifications" class="creds" aria-labelledby="certifications-title">
  <div class="creds__fields" aria-hidden="true"></div>
  <div class="creds__inner container">
    <div class="creds__top">
      <div class="creds__intro">
        <SectionHeading id="certifications-title" lead={credentials.heading.lead} accent={credentials.heading.accent} />
        <p class="section-intro creds__text">{credentials.intro}</p>
        <ul role="list" class="creds__stats" aria-label="Credentials at a glance">
          {stats.map((s) => (
            <li class="stat-tile">
              <span class="stat-tile__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" focusable="false">
                  {s.icon.map((d) => (
                    <path d={d} />
                  ))}
                </svg>
              </span>
              <span class="stat-tile__text">
                <span class="stat-tile__value">{s.value}</span>
                <span class="stat-tile__label">{s.label}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>

      <article class="cert-card" aria-labelledby="cert-card-title">
        <div class="cert-card__badge">
          <Image src={cert.image} alt="" widths={[160, 320]} sizes="140px" />
        </div>
        <div class="cert-card__body">
          <p class="cert-card__eyebrow">{cert.issuer}</p>
          <h3 id="cert-card-title" class="cert-card__title">
            {cert.title}
          </h3>
          <p class="cert-card__meta">
            {cert.level} · <span class="cert-card__validity">{cert.validity}</span>
          </p>
          <Pill href={profile.url} variant="outline-alt" size="compact" label="View Google Skills profile" newTab>
            VIEW PROFILE
          </Pill>
        </div>
      </article>
    </div>

    <div class="creds__group">
      <h3 class="creds__group-title">
        Skill badges <span class="creds__count">{shownSkillBadges.length}</span>
      </h3>
      <ul role="list" class="skill-grid">
        {shownSkillBadges.map((b) => (
          <li>
            <a class="badge-link" href={b.url} target="_blank" rel="noopener noreferrer">
              <Image
                src={b.image}
                alt={`${b.title}: ${b.level} skill badge, earned ${monthYear(b.earned)}`}
                widths={[280, 480]}
                sizes="(width >= 64rem) 280px, 45vw"
              />
              <span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </li>
        ))}
        <li>
          <a class="badge-more" href={profile.url} target="_blank" rel="noopener noreferrer">
            <span class="badge-more__count">{totalBadges}</span>
            <span class="badge-more__label">badges on {profile.platform}</span>
            <span class="badge-more__cta">View profile →</span>
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="creds__group" data-carousel data-carousel-label="badge" data-carousel-step="page">
      <div class="creds__group-head">
        <h3 class="creds__group-title">
          Completion badges <span class="creds__count">{shownCompletionBadges.length}</span>
        </h3>
        <a class="creds__all" href={profile.url} target="_blank" rel="noopener noreferrer">
          View all on {profile.platform}
          <span class="visually-hidden"> (opens in a new tab)</span>
        </a>
      </div>
      <ul
        id="completion-rail"
        role="list"
        class="rail"
        aria-label="Completion badges, newest first"
        data-carousel-track
      >
        {shownCompletionBadges.map((b) => (
          <li class="rail__item" data-carousel-slide>
            <a class="badge-link" href={b.url} target="_blank" rel="noopener noreferrer">
              <Image
                src={b.image}
                alt={`${b.title}: completion badge, earned ${monthYear(b.earned)}`}
                widths={[180, 360]}
                sizes="168px"
              />
              <span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="rail-footer">
        <div class="rail-progress" aria-hidden="true">
          <span class="rail-progress__thumb"></span>
        </div>
        <div class="rail-buttons">
          <button
            class="rail-btn"
            type="button"
            aria-label="Previous completion badges"
            aria-controls="completion-rail"
            data-carousel-prev
          >
            <Icon name="arrow-left" size={16} strokeWidth={1.8} />
          </button>
          <button
            class="rail-btn"
            type="button"
            aria-label="Next completion badges"
            aria-controls="completion-rail"
            data-carousel-next
          >
            <Icon name="arrow-next" size={16} strokeWidth={1.8} />
          </button>
        </div>
      </div>
      <p class="visually-hidden" aria-live="polite" data-carousel-status></p>
    </div>
  </div>
</section>

<style>
  .creds {
    position: relative;
    isolation: isolate;
    padding-block: 72px;
    background: var(--color-bg);
  }

  .creds__fields {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(520px 420px at calc(50% + min(36%, 520px)) 18%, rgb(40 100 255 / 22%), transparent 72%),
      radial-gradient(560px 460px at calc(50% - min(40%, 560px)) 78%, rgb(170 32 62 / 22%), transparent 72%);
  }

  .creds__top {
    display: grid;
    gap: 32px;
  }

  .creds__text {
    max-width: 560px;
    margin-block-start: 18px;
  }

  /* ---------- Stats: icon + value + label ---------- */

  .creds__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-block-start: 28px;
    overflow: hidden;
    border: 1px solid var(--color-hairline-soft);
    border-radius: 14px;
    background: var(--color-hairline-soft);
  }

  .stat-tile {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    background: rgb(10 12 20 / 92%);
  }

  .stat-tile__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid transparent;
    border-radius: 11px;
    background:
      linear-gradient(rgb(14 18 30), rgb(14 18 30)) padding-box,
      var(--gradient-date-pill) border-box;
  }

  .stat-tile__icon svg {
    fill: none;
    stroke: var(--color-white);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .stat-tile__text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .stat-tile__value {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    color: var(--color-white);
  }

  .stat-tile__label {
    font-size: var(--fs-caption);
    line-height: 1.3;
    color: var(--color-text-muted);
  }

  /* ---------- Featured certification: compact, badge beside the details ---------- */

  .cert-card {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 24px 26px;
    border: 1px solid transparent;
    border-radius: 20px;
    background:
      var(--gradient-card) padding-box,
      var(--gradient-card-feature-border) border-box;
    box-shadow: 0 24px 50px rgb(0 0 0 / 40%);
  }

  .cert-card__badge {
    position: relative;
    display: grid;
    flex: none;
    place-items: center;
  }

  .cert-card__badge::before {
    content: '';
    position: absolute;
    inset: -16%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(66 133 244 / 32%), rgb(234 67 53 / 10%) 60%, transparent);
  }

  .cert-card__badge :global(img) {
    width: 112px;
    height: auto;
    filter: drop-shadow(0 12px 24px rgb(0 0 0 / 45%));
  }

  .cert-card__body {
    display: grid;
    justify-items: start;
    gap: 6px;
  }

  .cert-card__eyebrow {
    color: var(--color-eyebrow-blue);
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .cert-card__title {
    font-size: var(--fs-h3-card);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-white);
  }

  .cert-card__meta {
    margin-block-end: 8px;
    font-size: var(--fs-body-sm);
    color: var(--color-text-soft);
  }

  .cert-card__validity {
    white-space: nowrap;
  }

  /* ---------- Badge groups ---------- */

  .creds__group {
    margin-block-start: 56px;
  }

  .creds__group-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
  }

  .creds__group-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--fs-lead);
    font-weight: 600;
    color: var(--color-white);
  }

  .creds__count {
    display: inline-grid;
    place-items: center;
    min-width: 26px;
    height: 20px;
    padding-inline: 7px;
    border-radius: var(--radius-pill);
    background: var(--gradient-date-pill);
    font-size: var(--fs-caption);
    font-weight: 700;
    color: var(--color-white);
  }

  .creds__all {
    color: var(--color-text-soft);
    font-size: var(--fs-body-sm);
    text-underline-offset: 3px;
  }

  .creds__all:hover {
    color: var(--color-white);
  }

  .badge-link {
    display: block;
    overflow: hidden;
    border-radius: 12px;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 10%),
      0 14px 30px rgb(0 0 0 / 40%);
    transition:
      transform var(--dur-card) ease,
      box-shadow var(--dur-card) ease;
  }

  .badge-link:hover {
    transform: var(--lift-card);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 22%),
      0 20px 44px rgb(0 0 0 / 50%);
  }

  .badge-link :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Fills the last gallery slot: the whole collection, one click away. */
  .badge-more {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 6px;
    height: 100%;
    min-height: 140px;
    padding: 20px;
    border: 1px dashed var(--color-hairline);
    border-radius: 12px;
    color: var(--color-text-soft);
    text-align: center;
    text-decoration: none;
    transition:
      border-color var(--dur-card) ease,
      background var(--dur-card) ease;
  }

  .badge-more:hover {
    border-color: rgb(255 255 255 / 35%);
    background: rgb(255 255 255 / 4%);
    color: var(--color-white);
  }

  .badge-more__count {
    font-family: var(--font-display);
    font-size: 3rem;
    line-height: 1;
    color: var(--color-white);
  }

  .badge-more__label {
    font-size: var(--fs-body-sm);
  }

  .badge-more__cta {
    margin-block-start: 6px;
    font-size: var(--fs-pill);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-white);
  }

  /* Skill badges: a gallery, legible at full size (4 across on desktop). */
  .skill-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: 16px;
    margin: 20px 0 0;
  }

  /*
   * Completion badges: a carousel. The track is a native scroller (touch, trackpad, keyboard and
   * no-JS all work); once scripts/carousel.ts has enhanced it, the scrollbar gives way to arrow
   * buttons, a slim progress line and edge fades on whichever side has more to show.
   */

  /* Below the rail, as is standard: the progress line, then the arrows. */
  .rail-footer {
    display: none;
    align-items: center;
    gap: 24px;
    margin-block-start: 14px;
  }

  [data-enhanced] .rail-footer {
    display: flex;
  }

  .rail-buttons {
    display: flex;
    flex: none;
    gap: 10px;
  }

  .rail-btn {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 50%;
    background:
      linear-gradient(rgb(12 15 26), rgb(12 15 26)) padding-box,
      linear-gradient(135deg, var(--color-blue-450), #8a6be0, var(--color-red-500)) border-box;
    color: var(--color-white);
    cursor: pointer;
    transition:
      transform var(--dur-pill) ease,
      box-shadow var(--dur-pill) ease,
      opacity var(--dur-pill) ease;
  }

  .rail-btn:hover:not([aria-disabled='true']) {
    transform: translateY(-1px);
    box-shadow: 0 8px 22px rgb(66 133 244 / 28%);
  }

  .rail-btn[aria-disabled='true'] {
    opacity: 0.3;
    cursor: default;
  }

  .rail {
    display: grid;
    grid-auto-columns: 168px;
    grid-auto-flow: column;
    gap: 16px;
    margin: 20px 0 0;
    padding-block: 6px 14px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    mask-image: linear-gradient(90deg, #000 calc(100% - 64px), transparent);
  }

  [data-enhanced] .rail {
    scrollbar-width: none;
  }

  [data-enhanced] .rail::-webkit-scrollbar {
    display: none;
  }

  [data-enhanced]:not([data-at-start], [data-at-end]) .rail {
    mask-image: linear-gradient(90deg, transparent, #000 64px, #000 calc(100% - 64px), transparent);
  }

  [data-enhanced][data-at-end]:not([data-at-start]) .rail {
    mask-image: linear-gradient(90deg, transparent, #000 64px);
  }

  [data-enhanced][data-at-start][data-at-end] .rail {
    mask-image: none;
  }

  .rail__item {
    scroll-snap-align: start;
  }

  /* Where you are in the rail: a gradient thumb, as wide as the share of badges in view. */
  .rail-progress {
    flex: 1;
    height: 2px;
    overflow: hidden;
    border-radius: 2px;
    background: var(--color-hairline-soft);
  }

  .rail-progress__thumb {
    display: block;
    width: calc(var(--carousel-thumb, 0.2) * 100%);
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--color-blue-450), #8a6be0, var(--color-red-500));
    transform: translateX(
      calc(var(--carousel-progress, 0) * (1 - var(--carousel-thumb, 0.2)) / var(--carousel-thumb, 0.2) * 100%)
    );
    transition: transform 0.15s linear;
  }

  /* ---------- Desktop ---------- */

  @media (width >= 64rem) {
    .creds {
      padding-block: 110px 100px;
    }

    /* The copy takes the room; the certification card keeps to its content (max 400px). */
    .creds__top {
      display: grid;
      grid-template-columns: minmax(0, 1fr) min(400px, 40%);
      align-items: center;
      gap: 56px;
    }

    .skill-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 20px;
    }
  }

  /* Four stats across only where each tile has room for its label. */
  @media (width >= 80rem) {
    .creds__stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (width < 40rem) {
    .cert-card {
      flex-direction: column;
      text-align: center;
    }

    .cert-card__body {
      justify-items: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .badge-link,
    .badge-more,
    .rail-btn,
    .rail-progress__thumb {
      transition: none;
    }

    .badge-link:hover {
      transform: none;
    }
  }
</style>

<script>
  import { initCarousel } from '../../scripts/carousel';

  for (const root of document.querySelectorAll<HTMLElement>('#certifications [data-carousel]')) initCarousel(root);
</script>
