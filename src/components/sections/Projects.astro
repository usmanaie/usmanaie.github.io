---
import { projects, projectsSection } from '../../content/projects';
import ProjectList from '../projects/ProjectList.astro';
import Pill from '../ui/Pill.astro';
import SectionHeading from '../ui/SectionHeading.astro';

/** The home page shows the featured projects, the design's three rows; /projects shows them all. */
const featured = projects
  .filter((project) => project.featured !== undefined)
  .sort((a, b) => (a.featured ?? 0) - (b.featured ?? 0));
---

<section id="projects" class="projects" aria-labelledby="projects-title">
  <div class="projects__inner container">
    <header class="projects__header">
      <SectionHeading id="projects-title" lead={projectsSection.heading.lead} accent={projectsSection.heading.accent} />
      <p class="section-intro projects__intro">{projectsSection.intro}</p>
      <Pill href="/projects" size="compact" label="View all projects" class="projects__all">
        {projectsSection.viewAll}
      </Pill>
    </header>
    <div class="projects__list">
      <ProjectList projects={featured} />
    </div>
  </div>
</section>

<style>
  .projects {
    position: relative;
    isolation: isolate;
    container-type: inline-size;
    overflow: clip;
    padding-block: 56px 64px;
    background: var(--color-bg);
  }

  .projects__header {
    display: grid;
    gap: 12px;
    justify-items: start;
  }

  .projects__intro {
    max-width: 660px;
  }

  .projects__list {
    display: grid;
    gap: 64px;
    margin-block-start: 40px;
  }

  @media (width >= 64rem) {
    .projects {
      padding-block: 56px 27px;
    }

    .projects__header {
      grid-template-columns: 1fr auto;
      column-gap: 24px;
    }

    .projects__header :global(.section-heading) {
      grid-column: 1 / -1;
    }

    .projects__header :global(.projects__all) {
      grid-column: 2;
      grid-row: 2;
      align-self: start;
      margin-block-start: -6px;
      margin-inline-end: -1px;
    }

    .projects__list {
      gap: 0;
    }

    .projects__list > :global(.project-slot:first-child .project) {
      min-height: 464px;
    }
  }
</style>
