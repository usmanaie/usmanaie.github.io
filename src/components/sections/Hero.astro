---
import { primaryNav, sectionHref } from '../../content/nav';
import { certification, hero } from '../../content/site';
import AgentFlow from '../hero/AgentFlow.astro';
import RingBadge from '../hero/RingBadge.astro';
import Icon from '../ui/Icon.astro';

/**
 * Hero (#top). At >= 1024px the design composition (copy | agent flow) is scaled as a whole
 * to fit the window, by width or height, whichever runs out first; below that it stacks.
 */
---

<section id="top" class="hero" aria-labelledby="hero-title" data-hero data-intro>
  <div class="hero__fields" aria-hidden="true"></div>
  <div class="hero__inner">
    <div class="hero__bar">
      <nav class="hero__nav" aria-label="Primary">
        <ul role="list" class="hero__nav-list">
          {primaryNav.map((item) => (
            <li>
              <a
                class="hero__nav-link"
                href={sectionHref(item.id, true)}
                data-spy-link={item.id}
                aria-current={item.id === 'top' ? 'location' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <a class="hero-pill hero-pill--nav" href="#contact">
        {hero.navCta}
        <Icon name="arrow-right" size={18} strokeWidth={1.8} class="hero-pill__icon" />
      </a>
    </div>

    <div class="hero__body">
      <div class="hero__copy">
        <h1 id="hero-title" class="hero__title">
          {hero.titleLines.map((line) => (
            <span class="hero__title-line">
              {line.map((word, i) => (
                <>
                  {i > 0 && ' '}
                  <span class:list={['hero__word', { 'hero__word--dim': word.dim }]}>{word.text}</span>
                </>
              ))}
            </span>
          ))}
        </h1>
        <p class="hero__sub">
          {hero.subheading.line1}
          <br class="hero__br" /> {hero.subheading.line2}{' '}
          <span class="hero__grad hero__grad--red">{hero.subheading.accentRed}</span>
          <br class="hero__br" /> {hero.subheading.line3}{' '}
          <span class="hero__grad hero__grad--blue">{hero.subheading.accentBlue}</span>
        </p>
        <p class="hero__text">
          {hero.body[0]}
          <br class="hero__br" /> {hero.body[1]}
        </p>
        <div class="hero__actions">
          <a class="hero-pill hero-pill--cta" href="#contact">
            {hero.cta}
            <Icon name="arrow-right-long" size={22} strokeWidth={1.6} class="hero-pill__icon" />
          </a>
          <RingBadge kind="trust" lines={hero.trust} />
        </div>
        <RingBadge
          kind="cert"
          lines={[certification.issuer, certification.name]}
          href={certification.credentialUrl}
          linkLabel={`Verify credential: ${certification.issuer}, ${certification.name}`}
        />
      </div>

      <AgentFlow />
    </div>
  </div>
</section>

<script>
  import { initHero } from '../../scripts/hero';

  initHero();
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: var(--color-bg-hero);
    color: var(--color-hero-text);
    font-family: var(--font-hero);
  }

  .hero__fields {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(42% 34% at 0% 62%, rgb(255 52 72 / 38%), transparent 72%),
      radial-gradient(40% 30% at 100% 26%, rgb(40 100 255 / 30%), transparent 72%),
      radial-gradient(46% 24% at 88% 100%, rgb(40 90 255 / 26%), transparent 72%),
      radial-gradient(50% 14% at 55% 0%, rgb(40 90 220 / 20%), transparent 75%);
  }

  .hero__inner {
    width: 100%;
    max-width: calc(var(--container) + 2 * var(--gutter-min));
    margin-inline: auto;
    padding: calc(var(--header-height) + 28px) max(var(--gutter-min), env(safe-area-inset-right)) 48px
      max(var(--gutter-min), env(safe-area-inset-left));
  }

  .hero__bar {
    display: none;
  }

  .hero__body {
    display: grid;
    gap: 40px;
  }

  /* ---------- Copy ---------- */

  .hero__copy {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 36rem;
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-weight: 400;
    font-stretch: 81%;
    font-size: min(42cqi, 12rem);
    line-height: 0.86;
    word-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-hero-headline);
  }

  .hero__word--dim {
    color: var(--color-hero-headline-dim);
  }

  .hero__sub {
    font-size: clamp(1.375rem, 1.1458rem + 1.0185vw, 1.9375rem);
    font-weight: 300;
    line-height: 1.258;
    letter-spacing: -0.005em;
  }

  .hero__br {
    display: none;
  }

  .hero__grad {
    background-clip: text;
    color: transparent;
  }

  .hero__grad--red {
    background-image: var(--gradient-text-red);
  }

  .hero__grad--blue {
    background-image: var(--gradient-text-blue);
  }

  .hero__text {
    max-width: 22rem;
    font-size: 0.9375rem;
    line-height: 1.4667;
    color: var(--color-hero-body);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-block-start: 6px;
  }

  /* ---------- Pills ---------- */

  .hero-pill {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    border: 1.5px solid transparent;
    border-radius: var(--radius-pill);
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
    transition:
      box-shadow var(--dur-pill) ease,
      transform var(--dur-pill) ease;
  }

  .hero-pill:hover {
    transform: var(--lift-pill);
    box-shadow: var(--glow-pill-hero-hover);
  }

  .hero-pill--nav {
    width: 146px;
    height: 46px;
    padding: 0 16px 0 22px;
    background:
      linear-gradient(var(--color-pill-fill), var(--color-pill-fill)) padding-box,
      var(--gradient-signature-nav) border-box;
    box-shadow: var(--glow-pill-nav);
    color: var(--color-text);
    font-size: 0.875rem;
  }

  .hero-pill--nav :global(.hero-pill__icon) {
    color: var(--color-red-350);
  }

  .hero-pill--cta {
    gap: 24px;
    height: 60px;
    padding: 0 30px 0 40px;
    background:
      linear-gradient(var(--color-pill-fill), var(--color-pill-fill)) padding-box,
      var(--gradient-signature-cta) border-box;
    box-shadow: var(--glow-pill-cta);
    color: var(--color-hero-cta);
    font-size: 0.9375rem;
  }

  .hero-pill--cta :global(.hero-pill__icon) {
    color: var(--color-white);
  }

  /* ---------- Flow stage (mobile) ---------- */

  .hero__body :global(.flow) {
    width: min(100%, 36rem);
    justify-self: center;
  }

  /* ---------- Desktop: the design composition, scaled to fit the window ---------- */

  @media (width >= 64rem) {
    /*
     * One design unit (--u) = 1/1600 of the design canvas, sized to whichever of width or
     * height runs out first (the canvas is 1600 x 1067, shown at 0.9 on a 1440 viewport).
     * Every size below is in design units, so the complete hero (nav, copy, CTA, badges and
     * the agent flow) always fits the window, like the mockup scaled to the page.
     * Small floors keep text readable on very small windows.
     */
    .hero {
      --u: min(calc(min(100vw, 1440px) / 1600), calc(100svh / 1067));

      display: flex;
      min-height: 100svh;
    }

    .hero__fields {
      background:
        radial-gradient(420px 520px at max(0%, 50% - 720px) 62%, rgb(255 52 72 / 40%), transparent 72%),
        radial-gradient(520px 380px at min(100%, 50% + 720px) 26%, rgb(40 100 255 / 30%), transparent 72%),
        radial-gradient(620px 300px at min(92%, 50% + 600px) 100%, rgb(40 90 255 / 26%), transparent 72%),
        radial-gradient(700px 160px at 50% 0%, rgb(40 90 220 / 20%), transparent 75%);
    }

    .hero__inner {
      display: flex;
      flex-direction: column;
      width: min(100% - 2 * var(--gutter-min), calc(1333 * var(--u)));
      max-width: none;
      padding: 0;
    }

    .hero__bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: calc(24 * var(--u));
      padding-block: calc(26 * var(--u)) calc(8 * var(--u));
    }

    .hero__nav-list {
      display: flex;
      gap: 0 calc(60 * var(--u));
      margin: 0;
    }

    .hero__nav-link {
      position: relative;
      display: block;
      padding-block: max(11px, calc(12 * var(--u)));
      color: var(--color-hero-nav);
      font-size: max(0.8125rem, calc(17.8 * var(--u)));
      line-height: 1.375;
      text-decoration: none;
      white-space: nowrap;
      transition: color var(--dur-link) ease;
    }

    .hero__nav-link:hover,
    .hero__nav-link[aria-current] {
      color: var(--color-white);
    }

    .hero__nav-link[aria-current]::after {
      content: '';
      position: absolute;
      left: 50%;
      top: calc(100% - 6px);
      width: 5px;
      height: 5px;
      margin-left: -2.5px;
      border-radius: 50%;
      background: var(--color-red-500);
      box-shadow: var(--glow-dot-red);
    }

    .hero-pill--nav {
      width: auto;
      height: max(44px, calc(51 * var(--u)));
      gap: calc(28 * var(--u));
      padding: 0 calc(18 * var(--u)) 0 calc(24 * var(--u));
      font-size: max(0.8125rem, calc(15.5 * var(--u)));
    }

    .hero__body {
      flex: 1;
      grid-template-columns: minmax(0, 560fr) minmax(0, 640fr);
      align-items: center;
      gap: calc(32 * var(--u));
      padding-block: calc(8 * var(--u)) calc(40 * var(--u));
    }

    .hero__copy {
      max-width: none;
      gap: 0;
    }

    .hero__title {
      font-size: min(calc(231 * var(--u)), 42cqi);
      line-height: 0.8485;
    }

    .hero__sub {
      margin-block-start: calc(26 * var(--u));
      font-size: max(1.125rem, calc(31 * var(--u)));
      line-height: 1.258;
    }

    .hero__text {
      max-width: none;
      margin-block-start: calc(10 * var(--u));
      font-size: max(0.8125rem, calc(15 * var(--u)));
      line-height: 1.4667;
    }

    .hero__actions {
      flex-wrap: nowrap;
      gap: calc(120 * var(--u));
      margin-block-start: calc(23 * var(--u));
    }

    .hero-pill--cta {
      gap: calc(24 * var(--u));
      height: max(44px, calc(60 * var(--u)));
      padding: 0 calc(30 * var(--u)) 0 calc(40 * var(--u));
      font-size: max(0.8125rem, calc(15 * var(--u)));
    }

    .hero__copy :global(.ring-badge) {
      --badge-size: calc(80 * var(--u));
    }

    .hero__copy :global(.cert) {
      margin-block-start: calc(20 * var(--u));
    }

    .hero__br {
      display: inline;
    }

    .hero__body :global(.flow) {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-pill,
    .hero__nav-link {
      transition: none;
    }

    .hero-pill:hover {
      transform: none;
    }
  }

  @media (forced-colors: active) {
    .hero-pill {
      border-color: LinkText;
    }

    .hero__grad {
      background: none;
      color: CanvasText;
    }
  }
</style>
