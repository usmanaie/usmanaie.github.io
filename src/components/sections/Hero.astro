---
import { Picture } from 'astro:assets';

import { primaryNav, sectionHref } from '../../content/nav';
import { hero } from '../../content/site';
import { heroImage } from '../../lib/hero-image';
import AgentOrb from '../hero/AgentOrb.astro';
import Icon from '../ui/Icon.astro';

/**
 * Hero (#top). At >= 1024px the design's 1600x1067 composition is kept intact and scaled
 * by a single unitless factor (--hero-scale) derived from the container width, so every
 * orb, connector and travelling object stays aligned. Below 1024px the copy re-flows and
 * the agent illustration becomes its own scaled block. Coordinates below are the design's.
 */

/** Connector paths in the agent canvas's coordinate system (design coords minus 640,140). */
const CONNECTORS = [
  { id: 'user', d: 'M 150 90 C 200 -20, 420 -20, 410 120 S 290 330, 365 460', tone: 'blue', delay: 0.04 },
  { id: 'llm', d: 'M 715 115 C 800 220, 650 290, 580 220 S 340 220, 365 460', tone: 'red', delay: 0.15 },
  { id: 'tools', d: 'M 105 460 C 30 570, 220 650, 280 560 S 440 420, 365 460', tone: 'blue', delay: 0.26 },
  { id: 'rag', d: 'M 725 515 C 810 450, 730 360, 630 405 S 450 510, 365 460', tone: 'rag', delay: 0.58 },
] as const;

const PARTICLES = ['a', 'b', 'c', 'd', 'e', 'f', 'g'] as const;
const POWER = ['head', 'neck', 'shoulder', 'hand', 'hip'] as const;
const WAVE =
  'M0 12 Q12.5 6 25 12 T50 12 T75 12 T100 12 T125 12 T150 12 T175 12 T200 12 T225 12 T250 12 T275 12 T300 12 T325 12 T350 12 T375 12 T400 12 T425 12 T450 12 T475 12 T500 12';
---

<section id="top" class="hero" aria-labelledby="hero-title" data-hero data-intro>
  <div class="hero__fields" aria-hidden="true"></div>
  <div class="hero__frame">
    <div class="hero__canvas">
      <div class="hero__panel" aria-hidden="true"></div>
      <div class="hero__lines" aria-hidden="true"></div>
      <div class="hero__shimmer" aria-hidden="true"></div>
      <div class="hero__halo" aria-hidden="true"></div>

      <nav class="hero__nav" aria-label="Primary">
        <ul role="list" class="hero__nav-list">
          {primaryNav.map((item) => (
            <li>
              <a
                class="hero__nav-link"
                href={sectionHref(item.id, true)}
                data-spy-link={item.id}
                aria-current={item.id === 'top' ? 'location' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <a class="hero-pill hero-pill--nav" href="#contact">
        {hero.navCta}
        <Icon name="arrow-right" size={18} strokeWidth={1.8} class="hero-pill__icon" />
      </a>

      <h1 id="hero-title" class="hero__title">
        {hero.titleLines.map((line) => (
          <span class="hero__title-line">
            {line.map((word, i) => (
              <>
                {i > 0 && ' '}
                <span class:list={['hero__word', { 'hero__word--dim': word.dim }]}>{word.text}</span>
              </>
            ))}
          </span>
        ))}
      </h1>

      <p class="hero__sub">
        {hero.subheading.line1}
        <br class="hero__br" /> {hero.subheading.line2}{' '}
        <span class="hero__grad hero__grad--red">{hero.subheading.accentRed}</span>
        <br class="hero__br" /> {hero.subheading.line3}{' '}
        <span class="hero__grad hero__grad--blue">{hero.subheading.accentBlue}</span>
      </p>
      <p class="hero__body">
        {hero.body[0]}
        <br class="hero__br" /> {hero.body[1]}
      </p>
      <a class="hero-pill hero-pill--cta" href="#contact">
        {hero.cta}
        <Icon name="arrow-right-long" size={22} strokeWidth={1.6} class="hero-pill__icon" />
      </a>

      <div class="hero__trust">
        <svg class="hero__trust-ring" width="80" height="80" viewBox="0 0 80 80" aria-hidden="true" focusable="false">
          <defs>
            <linearGradient id="hero-ring-g" x1="0" y1="1" x2="1" y2="0">
              <stop offset="0" stop-color="#2F7BFF"></stop>
              <stop offset=".5" stop-color="#8A6BE0"></stop>
              <stop offset="1" stop-color="#FF3B4E"></stop>
            </linearGradient>
          </defs>
          <circle
            cx="40"
            cy="40"
            r="36"
            fill="none"
            stroke="url(#hero-ring-g)"
            stroke-width="7"
            stroke-dasharray="1.6 5.9"
          ></circle>
        </svg>
        <svg class="hero__trust-plus" width="80" height="80" viewBox="0 0 80 80" aria-hidden="true" focusable="false">
          <path d="M40 33v14M33 40h14" stroke="#FFFFFF" stroke-width="1.6" stroke-linecap="round" fill="none"></path>
        </svg>
        <p class="hero__trust-text">
          {hero.trust[0]}
          <br class="hero__br" /> {hero.trust[1]}
        </p>
      </div>

      <div class="agent-frame">
        <div class="agent">
          <div class="agent__bob" aria-hidden="true">
            <div class="agent__ring agent__ring--back"></div>
            <Picture
              src={heroImage.src}
              width={heroImage.width}
              height={heroImage.height}
              quality={heroImage.quality}
              formats={['avif', 'webp']}
              alt=""
              loading="eager"
              decoding="async"
              fetchpriority="high"
              class="agent__img"
            />
            <div class="agent__mask agent__tint"></div>
            <div class="agent__mask agent__fill">
              <div class="agent__level"></div>
              <svg class="agent__crest" viewBox="0 0 300 24" preserveAspectRatio="none" focusable="false">
                <g class="agent__wave">
                  <path d={`${WAVE} V24 H0 Z`} class="agent__wave-fill"></path>
                </g>
              </svg>
            </div>
            <div class="agent__mask agent__glow">
              <div class="agent__surface"></div>
              <svg class="agent__crest" viewBox="0 0 300 24" preserveAspectRatio="none" focusable="false">
                <g class="agent__wave">
                  <path
                    d={WAVE}
                    fill="none"
                    stroke="#CFF1FF"
                    stroke-width="1.6"
                    vector-effect="non-scaling-stroke"
                  ></path>
                </g>
              </svg>
              <div class="agent__particles">
                {PARTICLES.map((p) => (
                  <span class:list={['agent__particle', `agent__particle--${p}`]} />
                ))}
              </div>
              <div class="agent__bloom"></div>
            </div>
            {POWER.map((p) => (
              <div class:list={['agent__power', `agent__power--${p}`]} />
            ))}
            <div class="agent__ring agent__ring--front"></div>
          </div>

          <button class="agent__replay" type="button" data-hero-replay>
            <span class="visually-hidden">{hero.replayLabel}</span>
          </button>

          {hero.orbs.map((orb) => (
            <AgentOrb {...orb} />
          ))}

          <div class="agent__overlay" aria-hidden="true">
            <div class="agent__pulse agent__pulse--user"></div>
            <div class="agent__pulse agent__pulse--llm"></div>
            <div class="agent__pulse agent__pulse--tools"></div>
            <div class="agent__pulse agent__pulse--rag"></div>

            <svg class="agent__connectors" viewBox="0 0 880 900" focusable="false">
              <defs>
                <filter id="hero-connector-blur">
                  <feGaussianBlur stdDeviation="5"></feGaussianBlur>
                </filter>
                <filter id="hero-connector-blur-lg">
                  <feGaussianBlur stdDeviation="6"></feGaussianBlur>
                </filter>
              </defs>
              {CONNECTORS.map((c) => (
                <g class:list={['agent__connector', `agent__connector--${c.id}`, `agent__connector--${c.tone}`]}>
                  <path
                    class="agent__trail agent__trail--glow"
                    d={c.d}
                    pathLength="1"
                    filter={c.tone === 'rag' ? 'url(#hero-connector-blur-lg)' : 'url(#hero-connector-blur)'}
                  />
                  <path class="agent__trail agent__trail--core" d={c.d} pathLength="1" />
                  <path class="agent__trail agent__trail--head" d={c.d} pathLength="1" />
                </g>
              ))}
            </svg>

            <div class="agent__flyer agent__flyer--user">
              <svg width="44" height="44" viewBox="0 0 100 100" focusable="false">
                <defs>
                  <linearGradient id="hero-msg-g" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#F2F8FF"></stop>
                    <stop offset="1" stop-color="#8CC0FF"></stop>
                  </linearGradient>
                </defs>
                <path
                  d="M16 22c0-6 4-10 10-10h48c6 0 10 4 10 10v34c0 6-4 10-10 10H44L28 82V66h-2c-6 0-10-4-10-10z"
                  fill="url(#hero-msg-g)"
                ></path>
                <circle cx="36" cy="39" r="5" fill="#2A5BB0"></circle>
                <circle cx="50" cy="39" r="5" fill="#2A5BB0"></circle>
                <circle cx="64" cy="39" r="5" fill="#2A5BB0"></circle>
              </svg>
            </div>
            <div class="agent__flyer agent__flyer--llm">
              <svg width="46" height="46" viewBox="0 0 100 100" focusable="false">
                <path
                  d="M50 6 C54 34 66 46 94 50 C66 54 54 66 50 94 C46 66 34 54 6 50 C34 46 46 34 50 6 Z"
                  fill="#FFD9DF"
                ></path>
                <circle cx="50" cy="50" r="7" fill="#FFFFFF"></circle>
              </svg>
            </div>
            <div class="agent__flyer agent__flyer--tools">
              <svg width="42" height="42" viewBox="0 0 100 100" focusable="false">
                <defs>
                  <linearGradient id="hero-gear-g" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#E4F4FF"></stop>
                    <stop offset="1" stop-color="#3B8CFF"></stop>
                  </linearGradient>
                </defs>
                <circle
                  cx="50"
                  cy="50"
                  r="33"
                  fill="none"
                  stroke="url(#hero-gear-g)"
                  stroke-width="13"
                  stroke-dasharray="11.5 11.5"
                ></circle>
                <circle cx="50" cy="50" r="27" fill="url(#hero-gear-g)"></circle>
                <circle cx="50" cy="50" r="10" fill="#0A0E18"></circle>
              </svg>
            </div>
            {['fall', 'rag'].map((kind) => (
              <div class:list={['agent__flyer', `agent__flyer--${kind}`]}>
                <svg width="52" height="52" viewBox="0 0 100 100" focusable="false">
                  <path d="M24 10h38l18 18v58c0 3-2 5-5 5H24c-3 0-5-2-5-5V15c0-3 2-5 5-5z" fill="#F4F8FF" />
                  <path d="M62 10v14c0 2 2 4 4 4h14z" fill="#C9D9F2" />
                  <path d="M30 44H68M30 56H68M30 68H56" stroke="#FF4D6A" stroke-width="5" stroke-linecap="round" />
                </svg>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initHero } from '../../scripts/hero';

  initHero();
</script>

<style>
  @property --lv {
    syntax: '<length>';
    inherits: true;
    initial-value: 0;
  }

  @property --c1 {
    syntax: '<color>';
    inherits: true;
    initial-value: rgb(130 195 255 / 50%);
  }

  @property --c2 {
    syntax: '<color>';
    inherits: true;
    initial-value: rgb(70 130 255 / 60%);
  }

  @property --hero-scale {
    syntax: '<number>';
    inherits: true;
    initial-value: 1;
  }

  @property --agent-scale {
    syntax: '<number>';
    inherits: true;
    initial-value: 1;
  }

  /* ============================================================
   * Section, colour fields and frame
   * ============================================================ */

  .hero {
    --T: 11s;

    position: relative;
    isolation: isolate;
    overflow: clip;
    background: var(--color-bg-hero);
    color: var(--color-hero-text);
    font-family: var(--font-hero);
  }

  .hero__fields {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(42% 30% at 0% 55%, rgb(255 52 72 / 42%), transparent 72%),
      radial-gradient(50% 24% at 100% 22%, rgb(40 100 255 / 32%), transparent 72%),
      radial-gradient(60% 20% at 92% 100%, rgb(40 90 255 / 30%), transparent 72%);
  }

  /* ============================================================
   * Mobile-first: re-flowed hero
   * ============================================================ */

  .hero__frame {
    padding-block: calc(var(--header-height) + 32px) 48px;
    padding-inline: max(var(--gutter-min), env(safe-area-inset-left)) max(var(--gutter-min), env(safe-area-inset-right));
  }

  .hero__canvas {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 40rem;
    margin-inline: auto;
  }

  .hero__panel {
    position: absolute;
    inset: -20px calc(var(--gutter-min) * -0.5) -24px;
    z-index: -1;
    border: 1px solid var(--color-panel-border);
    border-radius: var(--radius-panel);
    background:
      radial-gradient(60% 40% at 74% 70%, rgb(30 100 255 / 30%), transparent 70%),
      radial-gradient(50% 35% at 100% 90%, rgb(255 46 70 / 24%), transparent 70%), var(--gradient-panel);
    box-shadow: var(--shadow-panel);
  }

  .hero__lines,
  .hero__shimmer,
  .hero__halo {
    display: none;
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(5.25rem, 26vw, 12rem);
    font-stretch: 81%;
    line-height: 0.86;
    text-transform: uppercase;
    color: var(--color-hero-headline);
  }

  .hero__word--dim {
    color: var(--color-hero-headline-dim);
  }

  .hero__sub {
    font-size: clamp(1.375rem, 1.1458rem + 1.0185vw, 1.9375rem);
    font-weight: 300;
    line-height: 1.258;
    letter-spacing: -0.005em;
  }

  .hero__br {
    display: none;
  }

  .hero__grad {
    background-clip: text;
    color: transparent;
  }

  .hero__grad--red {
    background-image: var(--gradient-text-red);
  }

  .hero__grad--blue {
    background-image: var(--gradient-text-blue);
  }

  .hero__body {
    max-width: 22rem;
    font-size: 0.9375rem;
    line-height: 1.4667;
    color: var(--color-hero-body);
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    border: 1.5px solid transparent;
    border-radius: var(--radius-pill);
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
    transition:
      box-shadow var(--dur-pill) ease,
      transform var(--dur-pill) ease;
  }

  .hero-pill:hover {
    transform: var(--lift-pill);
    box-shadow: var(--glow-pill-hero-hover);
  }

  .hero-pill--nav {
    width: 146px;
    height: 46px;
    padding: 0 16px 0 22px;
    background:
      linear-gradient(var(--color-pill-fill), var(--color-pill-fill)) padding-box,
      var(--gradient-signature-nav) border-box;
    box-shadow: var(--glow-pill-nav);
    color: var(--color-text);
    font-size: 0.875rem;
  }

  .hero__nav,
  .hero-pill.hero-pill--nav {
    display: none;
  }

  .hero-pill--nav :global(.hero-pill__icon) {
    color: var(--color-red-350);
  }

  .hero-pill--cta {
    align-self: flex-start;
    width: min(299px, 100%);
    height: 60px;
    padding: 0 30px 0 40px;
    background:
      linear-gradient(var(--color-pill-fill), var(--color-pill-fill)) padding-box,
      var(--gradient-signature-cta) border-box;
    box-shadow: var(--glow-pill-cta);
    color: var(--color-hero-cta);
    font-size: 0.9375rem;
  }

  .hero-pill--cta :global(.hero-pill__icon) {
    color: var(--color-white);
  }

  .hero__trust {
    position: relative;
    display: flex;
    align-items: center;
    gap: 17px;
    min-height: 80px;
  }

  .hero__trust-ring,
  .hero__trust-plus {
    flex: none;
    overflow: visible;
  }

  .hero__trust-plus {
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0;
  }

  .hero__trust-ring {
    animation: hero-spin 30s linear infinite;
    transform-origin: 50% 50%;
  }

  .hero__trust-text {
    max-width: 180px;
    font-size: 1rem;
    line-height: 1.3125;
    color: var(--color-hero-trust);
  }

  /* ---------- Agent illustration block (scaled canvas) ---------- */

  .agent-frame {
    position: relative;
    container-type: inline-size;
    width: min(100%, 34rem);
    margin-inline: auto;
    aspect-ratio: 880 / 900;
  }

  .agent {
    --agent-scale: tan(atan2(100cqw, 880px));

    position: absolute;
    inset: 0 auto auto 0;
    width: 880px;
    height: 900px;
    transform: scale(var(--agent-scale));
    transform-origin: 0 0;
  }

  /* ============================================================
   * Desktop: the design's scaled 1600x1067 composition
   * ============================================================ */

  @media (width >= 64rem) {
    .hero__fields {
      background:
        radial-gradient(
          calc(420px * var(--hero-scale)) calc(520px * var(--hero-scale)) at max(0%, 50% - 720px) 62%,
          rgb(255 52 72 / 42%),
          transparent 72%
        ),
        radial-gradient(
          calc(520px * var(--hero-scale)) calc(360px * var(--hero-scale)) at min(100%, 50% + 720px) 30%,
          rgb(40 100 255 / 32%),
          transparent 72%
        ),
        radial-gradient(
          calc(620px * var(--hero-scale)) calc(300px * var(--hero-scale)) at min(92%, 50% + 604.8px) 100%,
          rgb(40 90 255 / 30%),
          transparent 72%
        ),
        radial-gradient(
          calc(700px * var(--hero-scale)) calc(160px * var(--hero-scale)) at 50% 0%,
          rgb(40 90 220 / 22%),
          transparent 75%
        );
    }

    .hero {
      --hero-scale: tan(atan2(min(100cqw, 1440px), 1600px));
    }

    .hero__frame {
      width: min(100%, 1440px);
      margin-inline: auto;
      padding: 0;
      aspect-ratio: 1440 / 960;
      overflow: hidden;
    }

    .hero__canvas {
      display: block;
      width: 1600px;
      max-width: none;
      height: 1067px;
      margin: 0;
      transform: scale(var(--hero-scale));
      transform-origin: 0 0;
    }

    .hero__panel {
      inset: 80px auto auto 70px;
      width: 1462px;
      height: 905px;
      background:
        radial-gradient(520px 640px at 74% 42%, rgb(30 100 255 / 30%), transparent 70%),
        radial-gradient(420px 560px at 100% 82%, rgb(255 46 70 / 24%), transparent 70%),
        radial-gradient(520px 420px at 0% 100%, rgb(255 46 70 / 7%), transparent 70%), var(--gradient-panel);
    }

    .hero__lines,
    .hero__shimmer,
    .hero__halo {
      display: block;
      position: absolute;
    }

    .hero__lines {
      left: 230px;
      top: 150px;
      width: 1080px;
      height: 800px;
      background: repeating-linear-gradient(90deg, rgb(140 165 215 / 9%) 0 1px, transparent 1px 15px);
      mask-image: linear-gradient(180deg, transparent 0%, #000 18%, #000 72%, transparent 100%);
    }

    .hero__shimmer {
      left: 820px;
      top: 160px;
      width: 500px;
      height: 780px;
      background: repeating-linear-gradient(90deg, rgb(60 140 255 / 42%) 0 1px, transparent 1px 15px);
      mask-image: radial-gradient(48% 50% at 50% 46%, #000 30%, transparent 100%);
      animation: hero-shimmer 7s ease-in-out infinite alternate;
    }

    .hero__halo {
      left: 700px;
      top: 150px;
      width: 640px;
      height: 640px;
      border-radius: 50%;
      background:
        radial-gradient(circle at 48% 44%, rgb(50 130 255 / 30%), transparent 58%),
        radial-gradient(circle at 70% 70%, rgb(255 60 80 / 16%), transparent 60%);
      animation: hero-halo var(--T) ease-in-out infinite both;
    }

    .hero__nav {
      display: block;
      position: absolute;
      left: 200px;
      top: 111px;
    }

    .hero__nav-list {
      display: flex;
      gap: 0 56px;
      margin: 0;
    }

    .hero__nav-link {
      position: relative;
      display: block;
      padding-block: 11px;
      color: var(--color-hero-nav);
      font-size: 1rem;
      line-height: 22px;
      text-decoration: none;
      white-space: nowrap;
      transition: color var(--dur-link) ease;
    }

    .hero__nav-link:hover,
    .hero__nav-link[aria-current] {
      color: var(--color-white);
    }

    .hero__nav-link[aria-current]::after {
      content: '';
      position: absolute;
      left: 50%;
      top: 100%;
      width: 5px;
      height: 5px;
      margin-left: -2.5px;
      border-radius: 50%;
      background: var(--color-red-500);
      box-shadow: var(--glow-dot-red);
    }

    .hero-pill.hero-pill--nav {
      display: inline-flex;
      position: absolute;
      left: 1307px;
      top: 117px;
    }

    .hero__title {
      position: absolute;
      left: 200px;
      top: 258px;
      display: block;
      font-size: 231px;
      font-stretch: 81%;
      line-height: 196px;
      word-spacing: 10px;
      pointer-events: none;
    }

    .hero__title-line {
      display: block;
    }

    .hero__title-line + .hero__title-line {
      margin-left: -4px;
    }

    .hero__sub {
      position: absolute;
      left: 203px;
      top: 664px;
      width: 460px;
      font-size: 31px;
      line-height: 39px;
    }

    .hero__br {
      display: inline;
    }

    .hero__body {
      position: absolute;
      left: 203px;
      top: 791px;
      width: 330px;
      max-width: none;
      font-size: 15px;
      line-height: 22px;
    }

    .hero-pill--cta {
      position: absolute;
      left: 198px;
      top: 858px;
      width: 299px;
    }

    .hero__trust {
      position: absolute;
      left: 639px;
      top: 849px;
      gap: 17px;
    }

    .hero__trust-text {
      width: 180px;
      font-size: 16px;
      line-height: 21px;
    }

    .agent-frame {
      position: absolute;
      left: 640px;
      top: 140px;
      width: 880px;
      margin: 0;
    }
  }

  /* ============================================================
   * Agent canvas contents (coords = design coords - (640, 140))
   * ============================================================ */

  .agent__bob {
    position: absolute;
    inset: 0;
    pointer-events: none;
    animation: hero-bob 6s ease-in-out infinite;
  }

  .agent__ring {
    position: absolute;
    left: 79px;
    top: calc(795px - var(--lv));
    width: 600px;
    height: 100px;
    border-radius: 50%;
    animation:
      hero-lvl var(--T) cubic-bezier(0.35, 0, 0.25, 1) infinite both,
      hero-vis var(--T) linear infinite both;
  }

  .agent__ring--back {
