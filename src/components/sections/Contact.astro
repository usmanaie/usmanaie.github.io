---
import { contact, site } from '../../content/site';
import { mailtoHref } from '../../lib/email';
import AgentPortrait from '../ui/AgentPortrait.astro';
import Icon from '../ui/Icon.astro';
import RotatingRingLink from '../ui/RotatingRingLink.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="contact__fields" aria-hidden="true"></div>
  <div class="contact__art" aria-hidden="true">
    <p class="contact__words">
      <span class="contact__word">{contact.backdrop[0]}</span>
      <span class="contact__word">{contact.backdrop[1]}</span>
    </p>
    <div class="contact__portrait">
      <AgentPortrait variant="contact" width={780} height={936} class="contact__portrait-svg" />
    </div>
  </div>

  <div class="contact__inner container">
    <div class="contact__copy">
      <SectionHeading
        id="contact-title"
        lead={contact.heading.lead}
        accent={contact.heading.accent}
        breakBeforeAccent
        class="contact__title"
      />
      <p class="contact__body">{contact.body}</p>
      <ul role="list" class="contact__links" aria-label="Contact options">
        <li>
          <a
            class="contact__link"
            href={site.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            title={contact.links.linkedin}
          >
            <Icon name="linkedin" size={20} strokeWidth={1.7} />
            <span class="visually-hidden">{contact.links.linkedin} (opens in a new tab)</span>
          </a>
        </li>
        <li>
          <a class="contact__link" href={`tel:${site.phone.tel}`} title={`Call ${site.phone.display}`}>
            <Icon name="phone" size={20} strokeWidth={1.7} />
            <span class="visually-hidden">Call {site.phone.display}</span>
          </a>
        </li>
        <li>
          <a class="contact__link" href={mailtoHref()} title={contact.links.email}>
            <Icon name="mail" size={20} strokeWidth={1.7} />
            <span class="visually-hidden">{contact.links.email}</span>
          </a>
        </li>
      </ul>
    </div>
    <RotatingRingLink
      href={mailtoHref()}
      label={contact.ringLabel}
      text="CONTACT US • CONTACT US • "
      size={140}
      radius={52}
      variant="contact"
      class="contact__ring"
    />
  </div>
</section>

<style>
  .contact {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    padding-block: 32px 48px;
  }

  /* The colour field continues behind the site footer, as in the design. */
  .contact__fields {
    position: absolute;
    inset: 0 0 -330px;
    z-index: -2;
    pointer-events: none;
    background:
      radial-gradient(520px 420px at calc(50% - min(50%, 720px)) 560px, rgb(30 58 170 / 45%), transparent 72%),
      radial-gradient(560px 460px at calc(50% + min(30.56%, 440px)) 500px, rgb(170 32 62 / 45%), transparent 72%);
  }

  .contact__art {
    position: relative;
    z-index: -1;
    height: clamp(300px, 80vw, 520px);
    overflow: hidden;
  }

  .contact__words {
    position: absolute;
    inset: 8% 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding-inline-end: var(--gutter-min);
    font-family: var(--font-display);
    font-stretch: 80%;
    font-size: clamp(4.5rem, 21vw, 13.75rem);
    line-height: 0.82;
    white-space: nowrap;
  }

  .contact__word {
    background: linear-gradient(180deg, rgb(138 142 153 / 42%), rgb(90 94 105 / 28%));
    background-clip: text;
    color: transparent;
  }

  .contact__portrait {
    position: absolute;
    inset: 0;
    mask-image: linear-gradient(#000 66%, transparent 96%);
  }

  .contact__portrait :global(.contact__portrait-svg) {
    position: absolute;
    left: 50%;
    top: 4%;
    width: auto;
    height: 115%;
    max-width: none;
    transform: translateX(-50%) scaleX(-1) rotate(8deg);
  }

  .contact__inner {
    display: grid;
    gap: 32px;
    justify-items: start;
    margin-block-start: -48px;
  }

  .contact :global(.contact__title) {
    font-size: var(--fs-h2-contact);
    line-height: 1.2059;
    letter-spacing: -0.02em;
  }

  .contact__body {
    max-width: 380px;
    margin-block-start: 18px;
    font-size: var(--fs-body-xs);
    line-height: 1.4815;
    color: var(--color-text-muted);
  }

  /* LinkedIn, call and email: round glass icon buttons in the site's gradient-border style (named for screen readers). */
  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-block-start: 28px;
  }

  .contact__link {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    background:
      linear-gradient(rgb(12 15 26 / 80%), rgb(12 15 26 / 80%)) padding-box,
      linear-gradient(135deg, rgb(47 107 255 / 70%), rgb(138 107 224 / 60%), rgb(255 59 78 / 70%)) border-box;
    backdrop-filter: blur(10px);
    color: var(--color-white);
    text-decoration: none;
    transition:
      transform var(--dur-pill) ease,
      box-shadow var(--dur-pill) ease;
  }

  .contact__link:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 22px rgb(66 133 244 / 25%);
  }

  .contact__link :global(.icon) {
    color: rgb(190 210 255);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact__link {
      transition: none;
    }

    .contact__link:hover {
      transform: none;
    }
  }

  @media (width >= 64rem) {
    .contact {
      min-height: 880px;
      padding-block: 310px 197px;
    }

    .contact__art {
      position: absolute;
      inset: 0;
      height: auto;
      overflow: visible;
    }

    .contact__words {
      inset: 0;
      display: block;
      padding: 0;
      font-size: 220px;
      line-height: 177px;
    }

    .contact__word {
      position: absolute;
      right: var(--gutter);
    }

    .contact__word:first-child {
      top: var(--section-start);
    }

    .contact__word:last-child {
      top: calc(var(--section-start) + 177px);
    }

    .contact__portrait {
      /* From the centre, but never over the copy column on narrower desktops (1024-1279px). */
      inset: 38px auto auto max(calc(50% - 420px), calc(var(--gutter) + 200px));
      width: 840px;
      height: 760px;
      overflow: hidden;
    }

    .contact__portrait :global(.contact__portrait-svg) {
      left: 30px;
      top: 15px;
      width: 780px;
      height: 936px;
      transform: scaleX(-1) rotate(8deg);
      transform-origin: 390px 338px;
    }

    .contact__inner {
      grid-template-columns: minmax(0, 778fr) minmax(0, 422fr);
      gap: 0;
      margin: 0;
    }

    .contact__copy {
      margin-inline-start: 6px;
    }

    /* Beside the portrait's chin, moving with the portrait (same left as .contact__portrait, +578px). */
    .contact__inner :global(.contact__ring) {
      position: absolute;
      top: 461px;
      left: calc(max(calc(50% - 420px), calc(var(--gutter) + 200px)) + 578px);
    }
  }
</style>
