---
import type { ReviewsContent } from '../../content/reviews';
import Icon from '../ui/Icon.astro';
import reviewsCss from './reviews.css?url';

/**
 * Colleague reviews carousel. Only rendered when real, permitted quotes exist
 * (see content/reviews.ts). The avatar artwork is defined once in a <symbol> and
 * referenced with <use>, so ids are never duplicated.
 */
interface Props {
  content: ReviewsContent;
}

const { content } = Astro.props;
const total = content.items.length;
---

<link rel="stylesheet" href={reviewsCss} />
<section id="reviews" class="reviews" aria-labelledby="reviews-title">
  <svg class="reviews__defs" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="reviews-avatar-g" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#4FC3FF"></stop>
        <stop offset=".5" stop-color="#2B6FFF"></stop>
        <stop offset=".6" stop-color="#C2306A"></stop>
        <stop offset="1" stop-color="#FF3D52"></stop>
      </linearGradient>
      <symbol id="reviews-avatar" viewBox="0 0 40 40">
        <circle cx="20" cy="20" r="20" fill="#121726"></circle>
        <path
          d="M20 7c6 0 9 5 9 10.5 0 5-2 8.5-5 10.5-2 1.3-6 1.3-8 0-3-2-5-5.5-5-10.5C11 12 14 7 20 7z"
          fill="url(#reviews-avatar-g)"
          opacity=".9"
        ></path>
        <rect x="12" y="15.5" width="13" height="4" rx="2" fill="#05070D"></rect>
        <circle cx="27.5" cy="17.5" r="2.3" fill="none" stroke="#9FE0FF" stroke-width="1.2"></circle>
        <path d="M8 40c1-6 6-9 12-9s11 3 12 9z" fill="#1B2A4A"></path>
      </symbol>
    </defs>
  </svg>

  <div class="reviews__inner container" data-carousel>
    <div class="reviews__header">
      <div>
        <h2 id="reviews-title" class="section-heading reviews__title">
          {content.heading.lead}
          <br />
          {content.heading.rest}
        </h2>
        <p class="section-intro reviews__note">{content.note}</p>
      </div>
      <div class="reviews__controls">
        <button
          class="reviews__arrow"
          type="button"
          aria-label="Previous review"
          aria-controls="reviews-track"
          data-carousel-prev
        >
          <Icon name="arrow-left" size={16} strokeWidth={1.8} />
        </button>
        <button
          class="reviews__arrow"
          type="button"
          aria-label="Next review"
          aria-controls="reviews-track"
          data-carousel-next
        >
          <Icon name="arrow-next" size={16} strokeWidth={1.8} />
        </button>
      </div>
    </div>
    <hr class="reviews__rule" />
    <div
      id="reviews-track"
      class="reviews__track"
      role="region"
      aria-roledescription="carousel"
      aria-label="Colleague reviews"
      tabindex="0"
      data-carousel-track
    >
      <ul role="list" class="reviews__list">
        {content.items.map((review, i) => (
          <li
            class="review"
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${total}`}
            data-carousel-slide
          >
            <svg class="review__mark" width="32" height="28" viewBox="0 0 32 28" aria-hidden="true" focusable="false">
              <path d="M0 28V16C0 7 4 2 12 0l2 4c-4 1-6 4-6 8h6v16H0zM18 28V16c0-9 4-14 12-16l2 4c-4 1-6 4-6 8h6v16H18z" />
            </svg>
            <figure class="review__figure">
              <blockquote class="review__quote">
                <p>{review.quote}</p>
              </blockquote>
              <p class="review__detail">{review.detail}</p>
              <figcaption class="review__person">
                <svg class="review__avatar" width="40" height="40" aria-hidden="true" focusable="false">
                  <use href="#reviews-avatar" />
                </svg>
                <span>
                  <span class="review__name">{review.name}</span>
                  <span class="review__role">{review.role}</span>
                </span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
    <p class="visually-hidden" aria-live="polite" data-carousel-status></p>
  </div>
</section>

<script>
  import { initCarousel } from '../../scripts/carousel';

  for (const root of document.querySelectorAll<HTMLElement>('#reviews [data-carousel]')) initCarousel(root);
</script>
