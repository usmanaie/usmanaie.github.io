---
import type { ReviewsContent } from '../../content/reviews';
import Icon from '../ui/Icon.astro';

/**
 * Colleague reviews carousel. Only rendered when real, permitted quotes exist
 * (see content/reviews.ts). The avatar artwork is defined once in a <symbol> and
 * referenced with <use>, so ids are never duplicated.
 */
interface Props {
  content: ReviewsContent;
}

const { content } = Astro.props;
const total = content.items.length;
---

<section id="reviews" class="reviews" aria-labelledby="reviews-title">
  <svg class="reviews__defs" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="reviews-avatar-g" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#4FC3FF"></stop>
        <stop offset=".5" stop-color="#2B6FFF"></stop>
        <stop offset=".6" stop-color="#C2306A"></stop>
        <stop offset="1" stop-color="#FF3D52"></stop>
      </linearGradient>
      <symbol id="reviews-avatar" viewBox="0 0 40 40">
        <circle cx="20" cy="20" r="20" fill="#121726"></circle>
        <path
          d="M20 7c6 0 9 5 9 10.5 0 5-2 8.5-5 10.5-2 1.3-6 1.3-8 0-3-2-5-5.5-5-10.5C11 12 14 7 20 7z"
          fill="url(#reviews-avatar-g)"
          opacity=".9"
        ></path>
        <rect x="12" y="15.5" width="13" height="4" rx="2" fill="#05070D"></rect>
        <circle cx="27.5" cy="17.5" r="2.3" fill="none" stroke="#9FE0FF" stroke-width="1.2"></circle>
        <path d="M8 40c1-6 6-9 12-9s11 3 12 9z" fill="#1B2A4A"></path>
      </symbol>
    </defs>
  </svg>

  <div class="reviews__inner container" data-carousel>
    <div class="reviews__header">
      <div>
        <h2 id="reviews-title" class="section-heading reviews__title">
          {content.heading.lead}
          <br />
          {content.heading.rest}
        </h2>
        <p class="section-intro reviews__note">{content.note}</p>
      </div>
      <div class="reviews__controls">
        <button
          class="reviews__arrow"
          type="button"
          aria-label="Previous review"
          aria-controls="reviews-track"
          data-carousel-prev
        >
          <Icon name="arrow-left" size={16} strokeWidth={1.8} />
        </button>
        <button
          class="reviews__arrow"
          type="button"
          aria-label="Next review"
          aria-controls="reviews-track"
          data-carousel-next
        >
          <Icon name="arrow-next" size={16} strokeWidth={1.8} />
        </button>
      </div>
    </div>
    <hr class="reviews__rule" />
    <div
      id="reviews-track"
      class="reviews__track"
      role="region"
      aria-roledescription="carousel"
      aria-label="Colleague reviews"
      tabindex="0"
      data-carousel-track
    >
      <ul role="list" class="reviews__list">
        {content.items.map((review, i) => (
          <li
            class="review"
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${total}`}
            data-carousel-slide
          >
            <svg class="review__mark" width="32" height="28" viewBox="0 0 32 28" aria-hidden="true" focusable="false">
              <path d="M0 28V16C0 7 4 2 12 0l2 4c-4 1-6 4-6 8h6v16H0zM18 28V16c0-9 4-14 12-16l2 4c-4 1-6 4-6 8h6v16H18z" />
            </svg>
            <figure class="review__figure">
              <blockquote class="review__quote">
                <p>{review.quote}</p>
              </blockquote>
              <p class="review__detail">{review.detail}</p>
              <figcaption class="review__person">
                <svg class="review__avatar" width="40" height="40" aria-hidden="true" focusable="false">
                  <use href="#reviews-avatar" />
                </svg>
                <span>
                  <span class="review__name">{review.name}</span>
                  <span class="review__role">{review.role}</span>
                </span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
    <p class="visually-hidden" aria-live="polite" data-carousel-status></p>
  </div>
</section>

<script>
  import { initCarousel } from '../../scripts/carousel';

  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) initCarousel(root);
</script>

<style>
  .reviews {
    padding-block: 66px 21px;
    background: var(--color-bg-reviews);
  }

  .reviews__defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .reviews__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .reviews__title {
    letter-spacing: -0.02em;
  }

  .reviews__note {
    max-width: 560px;
    margin-block-start: 12px;
  }

  .reviews__controls {
    display: none;
    gap: 13px;
  }

  [data-enhanced] .reviews__controls {
    display: flex;
  }

  .reviews__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(56px, 6vw, 76px);
    height: clamp(56px, 6vw, 76px);
    padding: 0;
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: 50%;
    background: transparent;
    color: var(--color-white);
    cursor: pointer;
    transition:
      background var(--dur-pill) ease,
      border-color var(--dur-pill) ease;
  }

  .reviews__arrow:hover {
    border-color: rgb(255 255 255 / 40%);
    background: rgb(255 255 255 / 6%);
  }

  .reviews__arrow:focus-visible {
    outline-offset: 3px;
  }

  .reviews__arrow[aria-disabled='true'] {
    opacity: 0.4;
    cursor: default;
  }

  .reviews__rule {
    height: 1px;
    margin: 27px 0 32px;
    border: 0;
    background: var(--gradient-divider-fade);
  }

  .reviews__track {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .reviews__track::-webkit-scrollbar {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .reviews__track {
      scroll-behavior: smooth;
    }
  }

  .reviews__list {
    display: flex;
    margin: 0;
  }

  .review {
    position: relative;
    flex: none;
    width: min(375px, 85%);
    min-height: 260px;
    padding-inline-end: 52px;
    scroll-snap-align: start;
  }

  .review::after {
    content: '';
    position: absolute;
    left: calc(100% - 23px);
    top: 0;
    width: 1px;
    height: 254px;
    background: var(--color-hairline-soft);
  }

  .review__mark {
    fill: #8a8d96;
  }

  .review__quote {
    margin: 10px 0 0;
    font-size: var(--fs-quote);
    font-weight: 600;
    line-height: 1.1538;
    letter-spacing: -0.01em;
    color: var(--color-white);
  }

  .review__detail {
    margin-block-start: 12px;
    font-size: var(--fs-body-sm);
    line-height: 1.4286;
    color: var(--color-text-soft);
  }

  .review__person {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-block-start: 24px;
    line-height: 1.2;
  }

  .review__avatar {
    flex: none;
  }

  .review__name {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    color: var(--color-heading);
  }

  .review__role {
    display: block;
    font-size: var(--fs-caption);
    color: rgb(230 233 240 / 75%);
  }

  @media (prefers-reduced-motion: reduce) {
    .reviews__arrow {
      transition: none;
    }
  }
</style>
