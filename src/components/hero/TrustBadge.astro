---
import { Picture } from 'astro:assets';

import badge from '../../assets/brand/gcp-professional-cloud-developer.png';
import { certification, hero } from '../../content/site';

/**
 * The design's trust badge: a slowly rotating dotted ring beside "Trusted by innovators
 * worldwide". The ring now holds the Google Cloud certification badge (official artwork,
 * unmodified) where the design had a "+". The badge's alt text carries the credential;
 * it links to the public verification page once `certification.credentialUrl` is set.
 */
const credential = `${certification.issuer}: ${certification.name}`;
---

<div class="trust">
  <span class="trust__mark">
    <svg class="trust__ring" width="80" height="80" viewBox="0 0 80 80" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="trust-ring-g" x1="0" y1="1" x2="1" y2="0">
          <stop offset="0" stop-color="#2F7BFF"></stop>
          <stop offset=".5" stop-color="#8A6BE0"></stop>
          <stop offset="1" stop-color="#FF3B4E"></stop>
        </linearGradient>
      </defs>
      <circle
        cx="40"
        cy="40"
        r="36"
        fill="none"
        stroke="url(#trust-ring-g)"
        stroke-width="7"
        stroke-dasharray="1.6 5.9"
      ></circle>
    </svg>
    {certification.credentialUrl ? (
      <a
        class="trust__badge-link"
        href={certification.credentialUrl}
        rel="noopener noreferrer"
        aria-label={`Verify credential: ${credential}`}
      >
        <Picture
          src={badge}
          alt=""
          formats={['avif', 'webp']}
          widths={[52, 104, 156]}
          sizes="52px"
          width={52}
          height={52}
          loading="eager"
          decoding="async"
          class="trust__badge"
        />
      </a>
    ) : (
      <Picture
        src={badge}
        alt={credential}
        formats={['avif', 'webp']}
        widths={[52, 104, 156]}
        sizes="52px"
        width={52}
        height={52}
        loading="eager"
        decoding="async"
        class="trust__badge"
      />
    )}
  </span>
  <p class="trust__text">
    {hero.trust[0]}
    <br /> {hero.trust[1]}
  </p>
</div>

<style>
  /* --trust-size scales the whole badge (the hero sizes it in design units on desktop). */
  .trust {
    --trust-size: 80px;

    display: flex;
    align-items: center;
    gap: calc(var(--trust-size) * 0.2125);
  }

  .trust__mark {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: var(--trust-size);
    height: var(--trust-size);
  }

  .trust__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    .trust__ring {
      animation: trust-spin 30s linear infinite;
      transform-origin: 50% 50%;
    }
  }

  .trust :global(.trust__badge) {
    position: relative;
    width: calc(var(--trust-size) * 0.65);
    height: calc(var(--trust-size) * 0.65);
    border-radius: 50%;
  }

  .trust__badge-link {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--touch-target);
    height: var(--touch-target);
    border-radius: 50%;
  }

  .trust__text {
    font-family: var(--font-hero);
    font-size: max(0.875rem, calc(var(--trust-size) * 0.2));
    line-height: 1.3125;
    white-space: nowrap;
    color: var(--color-hero-trust);
  }

  /* Paused with the rest of the hero when it is off-screen or the tab is hidden. */
  :global(.hero[data-paused]) .trust__ring {
    animation-play-state: paused;
  }

  @keyframes trust-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
