---
import { Picture } from 'astro:assets';

import badge from '../../assets/brand/gcp-professional-cloud-developer.png';
import { certification } from '../../content/site';

/**
 * Google Cloud certification chip. The badge is Google's official artwork, shown unmodified.
 * It becomes a link to the public credential once `certification.credentialUrl` is set.
 * The image is decorative (the text beside it says the same thing), so alt is empty.
 */
const Tag = certification.credentialUrl ? 'a' : 'div';
const linkProps = certification.credentialUrl
  ? {
      href: certification.credentialUrl,
      rel: 'noopener noreferrer',
      'aria-label': `Verify credential: ${certification.issuer}, ${certification.name}`,
    }
  : {};
---

<Tag class="cert" {...linkProps}>
  <Picture
    src={badge}
    alt=""
    formats={['avif', 'webp']}
    widths={[56, 112, 168]}
    sizes="56px"
    width={56}
    height={56}
    loading="eager"
    decoding="async"
    class="cert__img"
  />
  <span class="cert__text">
    <span class="cert__issuer">{certification.issuer}</span>
    <span class="cert__name">{certification.name}</span>
  </span>
</Tag>

<style>
  .cert {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: var(--touch-target);
    padding: 6px 20px 6px 6px;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    background:
      linear-gradient(rgb(9 12 22 / 92%), rgb(9 12 22 / 92%)) padding-box,
      linear-gradient(90deg, #4285f4 0%, #34a853 35%, #fbbc04 65%, #ea4335 100%) border-box;
    color: var(--color-text);
    text-decoration: none;
    transition:
      transform var(--dur-pill) ease,
      box-shadow var(--dur-pill) ease;
  }

  a.cert:hover {
    transform: var(--lift-pill);
    box-shadow: 0 8px 24px rgb(66 133 244 / 25%);
  }

  .cert :global(.cert__img) {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 50%;
  }

  .cert__text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .cert__issuer {
    font-family: var(--font-hero);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-hero-body);
  }

  .cert__name {
    font-family: var(--font-hero);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-white);
  }

  @media (forced-colors: active) {
    .cert {
      border-color: CanvasText;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cert {
      transition: none;
    }

    a.cert:hover {
      transform: none;
    }
  }
</style>
