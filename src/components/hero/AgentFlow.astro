---
import { Picture } from 'astro:assets';

import headLayers from '../../assets/hero/robot-head-layers.webp';
import { hero } from '../../content/site';
import { AGENT_CORE, flowNodes, GAZE, GAZE_FRONT, HEAD, hops, NODE_RADIUS, spokes, STAGE } from '../../lib/hero-flow';
import { robotImage } from '../../lib/hero-image';

/**
 * The hero's agent loop, hub and spoke: every message goes through the agent (the robot).
 * USER → AGENT → LLM, which requests tools; the AGENT runs RAG retrieval and TOOLS and
 * returns results to the LLM; GUARDRAILS check the answer before it goes back to the USER.
 *
 * The visual diagram is SVG (positions as attributes, so the strict CSP needs no inline
 * styles) and is aria-hidden; screen readers get every hop as an ordered list.
 * Static HTML shows all participants and connections (no-JS, reduced motion, first paint);
 * scripts/hero.ts then plays the request hop by hop, the token carrying each hop's label, and
 * the robot attends to the participant it is talking to: its eye lights glide across the visor and
 * the helmet tilts slightly (two layers cut from the photo, loaded only after the page has loaded;
 * first paint shows the photo, which faces the visitor).
 */
const ICONS: Record<string, string[]> = {
  user: ['M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z', 'M4.5 20c.8-3.6 3.8-6 7.5-6s6.7 2.4 7.5 6'],
  llm: [
    'M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z',
    'M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z',
    'M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4',
    'M12 5v13',
  ],
  rag: [
    'M3 5c0-1.66 3.13-3 7-3s7 1.34 7 3-3.13 3-7 3-7-1.34-7-3Z',
    'M3 5v12c0 1.66 3.13 3 7 3',
    'M3 11c0 1.66 3.13 3 7 3',
    'M17 5v5',
    'M17.5 19.8a3.3 3.3 0 1 0 0-6.6 3.3 3.3 0 0 0 0 6.6Z',
    'm22 21-2.1-2.1',
  ],
  tools: [
    'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z',
  ],
  guardrails: ['M12 3 4.5 6v5.5c0 4.6 3.2 8.6 7.5 9.5 4.3-.9 7.5-4.9 7.5-9.5V6L12 3Z', 'm8.8 12.2 2.3 2.3 4.4-4.6'],
};

const headRig = JSON.stringify({ ...HEAD.rig, gaze: GAZE, front: GAZE_FRONT });
const R = NODE_RADIUS;
/** Chip centre sits on the bubble's edge (upper-left, 45°), so it overlaps the bubble by half. */
const chipOffset = Math.round(R * Math.SQRT1_2);
const hopData = JSON.stringify(
  hops.map(({ spoke, direction, to, label, approves }) => ({ spoke, direction, to, label, approves })),
);
---

<div
  class="flow"
  data-flow
  data-hops={hopData}
  data-head-layers={headLayers.src}
  data-head-rig={headRig}
  data-head-seam={HEAD.seam}
>
  <ol class="visually-hidden" aria-label={hero.flowLabel}>
    {hops.map((hop) => (
      <li>{hop.text}</li>
    ))}
  </ol>

  <div class="flow__canvas">
    <div class="flow__halo" aria-hidden="true"></div>
    <div class="flow__lines" aria-hidden="true"></div>

    <div class="flow__robot">
      <Picture
        src={robotImage.src}
        widths={[...robotImage.widths]}
        sizes={robotImage.sizes}
        quality={robotImage.quality}
        formats={['avif', 'webp']}
        alt=""
        loading="eager"
        decoding="async"
        class="flow__robot-img"
      />
      <canvas class="flow__head" data-flow-head aria-hidden="true"></canvas>
      <div class="flow__charge" aria-hidden="true">
        <div class="flow__charge-level"></div>
        <div class="flow__charge-level flow__charge-level--approved"></div>
      </div>
    </div>

    <svg class="flow__diagram" viewBox={`0 0 ${STAGE.width} ${STAGE.height}`} aria-hidden="true" focusable="false">
      <defs>
        <radialGradient id="flow-bubble-blue" cx="34%" cy="28%" r="80%">
          <stop offset="0" stop-color="#ffffff" stop-opacity=".22"></stop>
          <stop offset=".25" stop-color="#ffffff" stop-opacity=".05"></stop>
          <stop offset=".6" stop-color="#0b1222" stop-opacity=".55"></stop>
          <stop offset="1" stop-color="#a0c8ff" stop-opacity=".18"></stop>
        </radialGradient>
        <radialGradient id="flow-bubble-red" cx="34%" cy="28%" r="80%">
          <stop offset="0" stop-color="#ffffff" stop-opacity=".22"></stop>
          <stop offset=".25" stop-color="#ffffff" stop-opacity=".05"></stop>
          <stop offset=".6" stop-color="#160b14" stop-opacity=".55"></stop>
          <stop offset="1" stop-color="#ffa0af" stop-opacity=".18"></stop>
        </radialGradient>
        <linearGradient id="flow-icon-blue" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#E4F4FF"></stop>
          <stop offset="1" stop-color="#3B8CFF"></stop>
        </linearGradient>
        <linearGradient id="flow-icon-red" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#FFE0E5"></stop>
          <stop offset="1" stop-color="#FF4D6A"></stop>
        </linearGradient>
        <filter id="flow-blur" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="4"></feGaussianBlur>
        </filter>
      </defs>

      <g class="flow__track">
        {spokes.map((s) => (
          <path d={s.out} data-spoke={s.id} />
        ))}
      </g>
      <g class="flow__segments">
        {spokes.map((s) => (
          <g
            class:list={['flow__seg', `flow__seg--${s.tone}`]}
            data-flow-spoke={s.id}
            data-first={s.firstDirection}
            data-out={s.out}
            data-back={s.back}
          >
            <path class="flow__seg-glow" d={s.out} pathLength="1" filter="url(#flow-blur)" />
            <path class="flow__seg-core" d={s.out} pathLength="1" />
          </g>
        ))}
      </g>

      {flowNodes.map((node) =>
        node.id === 'agent' ? (
          <g class="flow-node flow-node--agent" data-flow-node={node.id}>
            <circle class="flow-node__ring" cx={AGENT_CORE.x} cy={AGENT_CORE.y} r="26" />
            <circle class="flow-node__chip" cx={AGENT_CORE.x - 18} cy={AGENT_CORE.y - 18} r="13" />
            <text class="flow-node__chip-text" x={AGENT_CORE.x - 18} y={AGENT_CORE.y - 18}>
              {node.step}
            </text>
          </g>
        ) : (
          <g class:list={['flow-node', `flow-node--${node.tone}`]} data-flow-node={node.id}>
            <g class="flow-node__bubble">
              <circle class="flow-node__pulse" cx={node.x} cy={node.y} r={R} />
              <circle class="flow-node__disc" cx={node.x} cy={node.y} r={R} fill={`url(#flow-bubble-${node.tone})`} />
              <svg
                class="flow-node__icon"
                x={node.x - 17}
                y={node.y - 17}
                width="34"
                height="34"
                viewBox="0 0 24 24"
                stroke={`url(#flow-icon-${node.tone})`}
              >
                {(ICONS[node.id] ?? []).map((d) => (
                  <path d={d} />
                ))}
              </svg>
            </g>
            <circle class="flow-node__chip" cx={node.x - chipOffset} cy={node.y - chipOffset} r="13" />
            <text class="flow-node__chip-text" x={node.x - chipOffset} y={node.y - chipOffset}>
              {node.step}
            </text>
            <text class="flow-node__name" x={node.x} y={node.y + R + 22}>
              {node.label}
            </text>
          </g>
        ),
      )}
    </svg>

    <div class="flow__token" data-flow-token aria-hidden="true">
      <span class="flow__token-label" data-flow-label></span>
      <svg class="flow__token-icon" viewBox="0 0 40 40" width="40" height="40" focusable="false">
        <circle cx="20" cy="20" r="18" fill="#0B1222" stroke="#CFF1FF" stroke-width="2"></circle>
        <rect x="9" y="15" width="22" height="9" rx="4.5" fill="#03050A" stroke="#9FD8FF" stroke-width="1.2"></rect>
        <ellipse cx="15" cy="19.5" rx="3" ry="1.4" fill="#BFEAFF"></ellipse>
        <ellipse cx="25" cy="19.5" rx="3" ry="1.4" fill="#FFD0D6"></ellipse>
      </svg>
    </div>

    <button class="flow__replay" type="button" data-hero-replay>
      <span class="visually-hidden">{hero.replayLabel}</span>
    </button>
  </div>
</div>

<style>
  @property --flow-scale {
    syntax: '<number>';
    inherits: true;
    initial-value: 1;
  }

  @property --level {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }

  .flow {
    --step-travel: 1s;

    position: relative;
    container-type: inline-size;
    width: 100%;
    aspect-ratio: 720 / 880;

    /*
     * The robot runs off the stage's bottom edge (cropped at the shins): clip only there, so the
     * bars behind it can rise above the stage and fade out.
     */
    clip-path: inset(-50% -50% 0);
  }

  .flow__canvas {
    /* The stage's scale: the hero passes the design width (--stage-px), so extra width extends the stage. */
    --flow-scale: tan(atan2(var(--stage-px, 100cqw), 720px));

    position: absolute;
    inset: 0 auto auto 0;
    width: 720px;
    height: 880px;
    transform: scale(var(--flow-scale));
    transform-origin: 0 0;
  }

  .flow__halo {
    position: absolute;
    left: 80px;
    top: 60px;
    width: 640px;
    height: 820px;
    border-radius: 50%;
    background:
      radial-gradient(50% 42% at 50% 36%, rgb(50 130 255 / 30%), transparent 72%),
      radial-gradient(46% 40% at 66% 70%, rgb(255 60 80 / 16%), transparent 70%);
    pointer-events: none;
  }

  /*
   * Vertical bars behind the robot, as prominent as in the design: bright, blue-tinted lines that
   * glow strongest behind the head and shoulders and fade toward the edges and the floor.
   */
  .flow__lines {
    position: absolute;
    left: 20px;
    top: -160px;
    width: 680px;
    height: 1040px;
    background:
      repeating-linear-gradient(90deg, rgb(150 185 255 / 30%) 0 1px, transparent 1px 13px),
      repeating-linear-gradient(90deg, transparent 0 6px, rgb(90 130 230 / 12%) 6px 7px, transparent 7px 13px);
    mask-image: radial-gradient(52% 58% at 54% 42%, #000 28%, rgb(0 0 0 / 45%) 62%, transparent 100%);

    /* Decorative, and reaches up behind the nav: never intercept clicks. */
    pointer-events: none;
  }

  /* Same box as ROBOT in src/lib/hero-flow.ts (tests/unit/hero-flow.test.ts guards it). */
  .flow__robot {
    position: absolute;
    left: 248.5px;
    top: 10px;
    width: 343px;
    height: 875px;

    /* Fade into the page where the stage crops the legs, like a portrait's bottom edge. */
    mask-image: linear-gradient(#000 87%, transparent 99%);
  }

  .flow__robot :global(.flow__robot-img) {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    filter: drop-shadow(0 26px 40px rgb(0 0 0 / 55%));
  }

  /*
   * The attending head: a canvas over the head box (HEAD.box in hero-flow.ts: the band above the
   * collar, cropped to the head's columns; the unit test guards these numbers). Once it is drawing,
   * the photo is masked out under it (HEAD.hole: 2 px inside the box at the sides and bottom, where the
   * canvas draws the same neck and collar, so no hairline shows at the join).
   */
  .flow__head {
    position: absolute;
    top: 0;
    left: 97.64px;
    display: none;
    width: 141.87px;
    height: 171.83px;
  }

  .flow[data-head-live] .flow__head {
    display: block;
  }

  .flow[data-head-live] .flow__robot :global(.flow__robot-img) {
    mask-image: linear-gradient(#000 0 0), linear-gradient(#000 0 0);
    mask-size:
      100% 100%,
      137.87px 169.83px;
    mask-position:
      0 0,
      99.64px 0;
    mask-repeat: no-repeat;
    mask-composite: exclude;
  }

  /*
   * Energy charge: a tint that rises inside the robot's silhouette as the steps complete.
   * Hidden (and its mask not fetched) until scripts/hero.ts needs it: with the whole-robot mask
   * (data-charge-full) only if the head canvas is not live by then, so a visit normally fetches
   * just one of the two masks.
   */
  .flow__charge {
    position: absolute;
    inset: 0;
    display: none;
    mask-size: 100% 100%;
    mask-repeat: no-repeat;
    mix-blend-mode: multiply;
  }

  .flow[data-charge-full] .flow__charge {
    display: block;
    mask-image: url('../../assets/hero/robot-agent-mask.webp');
  }

  /* While the head turns on its canvas, the fill there is drawn on the canvas (scripts/hero.ts). */
  .flow[data-head-live] .flow__charge {
    display: block;
    mask-image: url('../../assets/hero/robot-agent-mask-body.webp');
  }

  .flow__charge-level {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(130 210 255 / 55%), rgb(90 150 255 / 42%) 55%, rgb(255 110 140 / 48%));
    transform: scaleY(var(--level));
    transform-origin: 50% 100%;
    transition: transform var(--step-travel) cubic-bezier(0.35, 0, 0.25, 1);
  }

  /* Guardrails approved the answer: the charge turns green (blue while the agent works). */
  .flow__charge-level--approved {
    background: linear-gradient(180deg, rgb(120 240 170 / 46%), rgb(40 200 130 / 36%) 55%, rgb(20 160 110 / 40%));
    opacity: 0;
    transition:
      transform var(--step-travel) cubic-bezier(0.35, 0, 0.25, 1),
      opacity 0.6s ease;
  }

  .flow[data-approved] .flow__charge-level--approved {
    opacity: 1;
  }

  /* Skip the masked/blended layer until the page is idle: keeps the first render (LCP) cheap. */
  :global(.hero[data-intro]) .flow__charge {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .flow__robot {
      animation: flow-bob 6s ease-in-out infinite;
    }
  }

  .flow__diagram {
    position: absolute;
    inset: 0;
    width: 720px;
    height: 880px;
    max-width: none;
    overflow: visible;
  }

  /* ---------- Connectors ---------- */

  .flow__track path {
    fill: none;
    stroke: rgb(160 190 240 / 14%);
    stroke-width: 1.5;
    stroke-dasharray: 2 7;
    stroke-linecap: round;
  }

  .flow__seg path {
    fill: none;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset var(--step-travel) cubic-bezier(0.45, 0, 0.25, 1);
  }

  .flow__seg-glow {
    stroke-width: 7;
    opacity: 0.7;
  }

  .flow__seg-core {
    stroke-width: 2;
  }

  .flow__seg--blue .flow__seg-glow {
    stroke: var(--color-blue-450);
  }

  .flow__seg--blue .flow__seg-core {
    stroke: #cdebff;
  }

  .flow__seg--red .flow__seg-glow {
    stroke: var(--color-red-500);
  }

  .flow__seg--red .flow__seg-core {
    stroke: #ffd3d9;
  }

  /* ---------- Nodes ---------- */

  .flow-node {
    transition: opacity 0.5s ease;
  }

  .flow-node__bubble {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.6s var(--ease-out-expo);
  }

  .flow-node__disc {
    stroke-width: 1;
  }

  .flow-node--blue .flow-node__disc {
    stroke: rgb(200 225 255 / 35%);
  }

  .flow-node--red .flow-node__disc {
    stroke: rgb(255 210 220 / 38%);
  }

  .flow-node__icon {
    fill: none;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }

  .flow-node__pulse {
    fill: none;
    stroke-width: 2;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .flow-node--blue .flow-node__pulse {
    stroke: rgb(190 230 255 / 90%);
  }

  .flow-node--red .flow-node__pulse {
    stroke: rgb(255 210 220 / 90%);
  }

  .flow-node__chip {
    fill: #fff;
    stroke: rgb(5 6 11 / 60%);
    stroke-width: 1;
  }

  .flow-node__chip-text {
    fill: #05060b;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    text-anchor: middle;
    dominant-baseline: central;
  }

  .flow-node__name {
    --label-size: 14px;

    text-anchor: middle;
    paint-order: stroke;
    stroke: var(--color-bg-hero);
    stroke-width: 5px;
    stroke-linejoin: round;
    font-size: calc(var(--label-size) * max(1, 0.62 / var(--flow-scale)));
    fill: #fff;
    font-family: var(--font-hero);
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .flow-node--red .flow-node__name {
    fill: var(--color-orb-label-rag);
  }

  .flow-node__ring {
    fill: none;
    stroke: rgb(190 230 255 / 85%);
    stroke-width: 2;
    stroke-dasharray: 4 5;
  }

  /* ---------- Agent token ---------- */

  .flow__token {
    position: absolute;
    left: 0;
    top: 0;
    width: 40px;
    height: 40px;
    offset-anchor: 50% 50%;
    offset-rotate: 0deg;
    offset-distance: 0%;
    opacity: 0;
    transition:
      offset-distance var(--step-travel) cubic-bezier(0.45, 0, 0.25, 1),
      opacity 0.3s ease;
    pointer-events: none;
  }

  .flow__token-icon {
    filter: drop-shadow(0 0 10px rgb(110 200 255 / 85%));
  }

  /* The hop's message rides above the token ("request", "tool call: retrieve", ...). */
  .flow__token-label {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    padding: 5px 12px;
    border: 1px solid rgb(200 225 255 / 35%);
    border-radius: var(--radius-pill);
    background: rgb(8 12 22 / 88%);
    color: var(--color-white);
    font-family: var(--font-mono);
    font-size: calc(13px * max(1, 0.62 / var(--flow-scale)));
    line-height: 1.2;
    white-space: nowrap;
    transform: translateX(-50%);
    transform-origin: 50% 100%;
    box-shadow: 0 6px 18px rgb(0 0 0 / 45%);
    transition: opacity 0.25s ease;
  }

  .flow__token-label:empty {
    opacity: 0;
  }

  .flow__token.is-jumping {
    transition: none;
  }

  /* ---------- Replay (the robot is the hit area; never covers a bubble) ---------- */

  .flow__replay {
    position: absolute;
    left: 280px;
    top: 20px;
    width: 280px;
    height: 840px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 140px;
    background: transparent;
    cursor: pointer;
  }

  .flow__replay:focus-visible {
    outline-width: 3px;
  }

  /* ---------- Live playback (scripts/hero.ts adds data-live) ---------- */

  .flow[data-live] .flow-node:not(.is-visited) {
    opacity: 0;
  }

  .flow[data-live] .flow-node:not(.is-visited) .flow-node__bubble {
    transform: scale(0.55);
  }

  .flow[data-live] .flow__seg:not(.is-drawn) path {
    stroke-dashoffset: 1;
  }

  /* A spoke first used inward (e.g. USER → AGENT) draws from the node towards the agent. */
  .flow[data-live] .flow__seg[data-first='back']:not(.is-drawn) path {
    stroke-dashoffset: -1;
  }

  .flow[data-live] .flow__seg.is-drawn:not(.is-active) {
    opacity: 0.4;
  }

  .flow__seg {
    transition: opacity 0.4s ease;
  }

  .flow[data-live] .flow__token {
    opacity: 1;
  }

  .flow-node.is-active .flow-node__pulse {
    animation: flow-pulse 1.4s ease-out infinite;
  }

  .flow-node.is-active .flow-node__bubble {
    transform: scale(1.08);
  }

  .flow[data-live] .flow-node--agent .flow-node__ring {
    animation: flow-spin 4s linear infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .flow[data-resetting] *,
  .flow[data-resetting] :global(*) {
    transition: none;
  }

  /* Paused off-screen / hidden tab (the hero carries data-paused) */
  :global(.hero[data-paused]) .flow :global(*) {
    animation-play-state: paused;
  }

  @keyframes flow-pulse {
    from {
      opacity: 0.9;
      transform: scale(1);
    }

    to {
      opacity: 0;
      transform: scale(1.45);
    }
  }

  @keyframes flow-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes flow-bob {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-6px);
    }
  }

  /* Narrow screens: larger step names and hop labels (the stage is scaled down). */
  @media (width < 40rem) {
    .flow-node__name {
      font-size: calc(var(--label-size) * max(1, 0.78 / var(--flow-scale)));
      transform: translateY(8px);
    }

    .flow__token-label {
      font-size: calc(13px * max(1, 0.8 / var(--flow-scale)));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow :global(*) {
      animation: none;
      transition: none;
    }
  }

  @supports not (offset-path: path('M 0 0')) {
    .flow__token {
      display: none;
    }
  }
</style>
