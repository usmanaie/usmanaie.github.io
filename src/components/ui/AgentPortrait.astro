---
import { portraitSrc, type PortraitVariant } from '../../lib/agent-portrait';

/**
 * The illustrated agent head used in Experience and Contact (drawing and colourways in
 * src/lib/agent-portrait.ts). A cached SVG file rather than inline markup: it keeps the home
 * page HTML inside the first round trip. Decorative: empty alt.
 */
interface Props {
  variant: PortraitVariant;
  width: number;
  height: number;
  class?: string;
}

const { variant, width, height, class: className } = Astro.props;
---

<img
  class={className}
  src={portraitSrc(variant)}
  width={width}
  height={height}
  alt=""
  loading="lazy"
  decoding="async"
/>
