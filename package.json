{
  "name": "usman-aslam-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/prune-dist.mjs dist && node scripts/check-dist.mjs dist",
    "build:fixture": "cross-env PUBLIC_REVIEWS_FIXTURE=true astro build && node scripts/prune-dist.mjs dist-fixture",
    "preview": "node scripts/serve.mjs dist 4173",
    "preview:fixture": "node scripts/serve.mjs dist-fixture 4174",
    "typecheck": "astro check --minimumFailingSeverity hint",
    "lint": "pnpm lint:js && pnpm lint:css && pnpm format:check",
    "lint:js": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"src/**/*.{css,astro}\" --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --project=visual",
    "lhci": "lhci autorun",
    "fonts": "node scripts/build-fonts.mjs",
    "images": "node scripts/build-images.mjs",
    "design:render": "node scripts/render-design-assets.mjs",
    "fidelity": "node scripts/fidelity.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "astro": "7.4.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.13.0",
    "@capsizecss/core": "^4.1.3",
    "@capsizecss/metrics": "^4.3.0",
    "@capsizecss/unpack": "^4.0.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/league-gothic": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "subset-font": "^2.9.0",
    "svgo": "^4.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
